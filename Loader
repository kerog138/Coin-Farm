local function safe(fn, fallback) local ok, v = pcall(fn) if ok and v ~= nil then return v end return fallback or "-" end
function UI.update()
    if UI.sizeSquare then pcall(UI.sizeSquare) end
    local sqScale = UI.gui:FindFirstChild("SquareScale", true)
    if sqScale then sqScale.Scale = Settings.squareScale / 100 end
    if UI.overlay then
        UI.overlay.Visible = Settings.overlay
        local scaleObj = UI.overlay:FindFirstChild("OverlayScale")
        if scaleObj then scaleObj.Scale = Settings.overlayScale / 100 end
        if Settings.overlay then
            local rows = safe(Stats.rows, {})
            for i, r in ipairs(UI.statRows) do
                local data = rows[i]
                r.row.Visible = data ~= nil
                if data then r.k.Text, r.v.Text = tostring(data[1]), tostring(data[2]) end
            end
        end
    end
    if UI.status and UI.isOpen() then
        local text = table.concat({
            "Farm: " .. safe(function() return Farm.note end),
            "Round: " .. safe(function() return Game.note end),
            "Vote: " .. safe(function() return Vote.note end),
            "Anti-AFK: " .. (Settings.antiAfk and plural(AntiAfk.runs, "kick", "kicks") .. " prevented" or "off"),
            "Webhook: " .. safe(function() return Hook.status end),
        }, "\n")
        if UI.status.Text ~= text then UI.status.Text = text end
    end
end

