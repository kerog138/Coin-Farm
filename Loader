    local view = variant:FindFirstChild("ViewContents", true)
    if not view or not shopPageVisible(view, variant) then return nil end
    local idKey, nameKey = shopKey(entry.id), shopKey(entry.name)
    for _, node in ipairs(view:GetDescendants()) do
        if node:IsA("TextLabel") or node:IsA("TextButton") then
