    local planeHolder = create("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 303), Size = UDim2.fromOffset(88, 88), BackgroundTransparency = 1, Visible = true, ZIndex = 5002, Parent = center})
    local plane
