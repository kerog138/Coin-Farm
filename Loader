local BAL_CACHE = 0.5
local balCache = {at = -math.huge}
local function readBalance()
    if now() - balCache.at >= BAL_CACHE then
        balCache.n, balCache.src = readBalanceNow()
        balCache.at = now()
    end
    return balCache.n, balCache.src
end
local function hasKnife(p, char)
    local bp = p:FindFirstChild("Backpack")
    return (bp and bp:FindFirstChild("Knife") or char and char:FindFirstChild("Knife")) ~= nil
end
local function hasGun(p, char)
    local bp = p:FindFirstChild("Backpack")
    return (bp and bp:FindFirstChild("Gun") or char and char:FindFirstChild("Gun")) ~= nil
end
local ROUND_GONE_AFTER = 3
function Game.update()
    local cc, map = Game.findContainer()
    if cc then
        Game.goneAt = nil
    elseif Game.cc then
        Game.goneAt = Game.goneAt or now()
        if now() - Game.goneAt < ROUND_GONE_AFTER then cc, map = Game.cc, Game.map end
    end
    if cc ~= Game.cc then
        if Game.cc then Game.roundEnd() end
        Game.cc, Game.map = cc, map
        Game.bag, Game.full, Game.bagFull, Game.roundGain = 0, false, false, 0
        Game.startBal, Game.startSrc, Game.pickupsStopped = nil, nil, false
        if cc then
            Game.roundId, Game.roundAt = Game.roundId + 1, now()
            Session.stats.roundBag = 0
            Log.add("round on " .. map.Name)
        end
    end
    local _, hrp, hum = myChar()
    local inRound = false
    if cc and cc.Parent and hrp and hum and hum.Health > 0 then
        local here = hrp.Position
        local lobby = Game.lobbyPos()
        if not (lobby and (here - lobby).Magnitude < LOBBY_RADIUS) then
            local sp = Game.spawnPos()
            if sp and (here - sp).Magnitude < MAP_RADIUS then
                inRound = true
            else
                for _, c in ipairs(Game.coins()) do
                    if (c.Position - here).Magnitude <= COIN_RADIUS then inRound = true break end
                end
            end
        end
    end
    Game.inRound = inRound
    local murderers, others = {}, {}
    local murdererPlayer, sheriffPlayer
    Game.imMurderer = false
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local knife = cc ~= nil and hasKnife(p, char)
        if p == LocalPlayer then
            Game.imMurderer = knife
        elseif root then
            if knife then
                murderers[#murderers + 1] = root.Position
                murdererPlayer = murdererPlayer or p
            end
            if cc ~= nil and not sheriffPlayer and hasGun(p, char) then sheriffPlayer = p end
            others[#others + 1] = root.Position
        end
    end
    Game.murderers, Game.others = murderers, others
    Game.murdererPlayer, Game.sheriffPlayer = murdererPlayer, sheriffPlayer
    if cc and cc.Parent then
        Game.readBag()
        local bal, src = readBalance()
        if bal then
            if not Game.startBal or src ~= Game.startSrc or bal < Game.startBal then Game.startBal, Game.startSrc = bal - Game.roundGain, src end
            Game.roundGain = math.max(Game.roundGain, bal - Game.startBal)
            Session.stats.roundBag = math.max(Session.stats.roundBag, Game.roundGain)
        end
        Game.full = Game.bagFull or Game.roundGain >= Game.bagCap() or Game.pickupsStopped
    end
    Game.note = not cc and "lobby" or (inRound and ("round on " .. map.Name) or "in the lobby, round running")
end

local Mover = {path = nil, i = 0, pos = nil, v = 0, arrived = false, yaw = 0, prone = false, collide = {}}
local ACCEL = 65
local TURN_RATE = 8
local LAY_TILT = CFrame.Angles(math.rad(-90), 0, 0)
function Mover.go(points, prone)
    local _, hrp = myChar()
    if not hrp then return false end
    if not Mover.path then
        local lv = hrp.CFrame.LookVector
        if math.abs(lv.Y) < 0.9 then Mover.yaw = math.atan2(-lv.X, -lv.Z) end
        Mover.pos, Mover.v = hrp.Position, 0
    end
    Mover.path, Mover.i, Mover.prone, Mover.arrived = points, 1, prone, false
    return true
end
function Mover.restoreCollision()
    for part, v in pairs(Mover.collide) do if part.Parent then pcall(function() part.CanCollide = v end) end end
    Mover.collide = {}
end
function Mover.stop()
    if not Mover.path then return end
    Mover.path, Mover.v = nil, 0
    local _, hrp, hum = myChar()
    if hrp then
        local bv = hrp:FindFirstChild("_hub_bv")
        if bv then bv:Destroy() end
        pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, Mover.yaw, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
    end
    if hum then pcall(function() hum.PlatformStand = false hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    Mover.restoreCollision()
end
local function turnToward(from, to, alpha)
    local diff = (to - from + math.pi) % (2 * math.pi) - math.pi
    return from + diff * alpha
end
bind(RunService.Heartbeat, function(dt)
    if not Mover.path then return end
    local _, hrp, hum = myChar()
    if not hrp then return end
    if not hrp:FindFirstChild("_hub_bv") then
        local bv = Instance.new("BodyVelocity")
        bv.Name, bv.Velocity, bv.MaxForce = "_hub_bv", Vector3.zero, Vector3.new(9e8, 9e8, 9e8)
        bv.Parent = hrp
    end
    Mover.pos = Mover.pos or hrp.Position
    local goal = Mover.path[Mover.i]
    if goal then
        local delta = goal - Mover.pos
        local dist = delta.Magnitude
        local top = Settings.speed
        Mover.v = Mover.v < top and math.min(top, Mover.v + ACCEL * dt) or top
        local step = Mover.v * dt
        if step >= dist then
            Mover.pos = goal
            Mover.i = Mover.i + 1
            if Mover.i > #Mover.path then Mover.arrived = true end
        else
            Mover.pos = Mover.pos + delta.Unit * step
        end
        local flat = Vector3.new(delta.X, 0, delta.Z)
        if Mover.prone and flat.Magnitude > 0.5 then
            Mover.yaw = turnToward(Mover.yaw, math.atan2(-flat.X, -flat.Z), math.min(1, dt * TURN_RATE))
        end
    end
    local cf = CFrame.new(Mover.pos) * CFrame.Angles(0, Mover.yaw, 0)
    if Mover.prone then cf = cf * LAY_TILT end
    hrp.CFrame = cf
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    if hum and Mover.prone ~= hum.PlatformStand then hum.PlatformStand = Mover.prone end
end)
bind(RunService.Stepped, function()
    if not (Mover.path and Settings.noclip) then return end
    local char = LocalPlayer.Character
    for _, part in ipairs(char and char:GetChildren() or {}) do
        if part:IsA("BasePart") and part.CanCollide then
            if Mover.collide[part] == nil then Mover.collide[part] = true end
            part.CanCollide = false
        end
    end
end)
bind(LocalPlayer.CharacterAdded, function() Mover.path, Mover.pos, Mover.v, Mover.collide = nil, nil, 0, {} end)

bind(RunService.Heartbeat, function()
    if not Settings.antiFling then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and (hrp.AssemblyLinearVelocity.Magnitude > 150 or hrp.AssemblyAngularVelocity.Magnitude > 150) then
        hrp.AssemblyLinearVelocity = Vector3.zero
