        end
    end
end)

local FarmAnimation = {character = nil, script = nil, disabled = nil, animator = nil, connection = nil}
function FarmAnimation.restore()
    local a = FarmAnimation
    if a.connection then pcall(function() a.connection:Disconnect() end) end
    if a.script and a.script.Parent and a.disabled ~= nil then
        pcall(function() a.script.Disabled = a.disabled end)
    end
    a.character, a.script, a.disabled, a.animator, a.connection = nil, nil, nil, nil, nil
end
function FarmAnimation.update()
    local a = FarmAnimation
    local char, _, hum = myChar()
    if not Session.alive or not Settings.farm or not char or not hum or hum.Health <= 0 then
        if a.character then a.restore() end
        return
    end
    if a.character ~= char then a.restore() a.character = char end
    local animate = char:FindFirstChild("Animate")
    if animate and animate ~= a.script and animate:IsA("LocalScript") then
        a.script, a.disabled = animate, animate.Disabled
        animate.Disabled = true
    end
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator ~= a.animator then
        if a.connection then pcall(function() a.connection:Disconnect() end) end
        a.animator, a.connection = animator, nil
        if animator then
            a.connection = animator.AnimationPlayed:Connect(function(track)
                if Session.alive and Settings.farm and a.character == char then pcall(function() track:Stop(0.05) end) end
            end)
        end
    end
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() track:Stop(0.05) end) end
    end
end
local VOID_GAP, VOID_MIN = 40, -450
local PICKUP_RETRY = 2
local TELEPORT_MIN_DWELL, TELEPORT_MAX_DWELL, TELEPORT_PARK_DWELL = 0.75, 3.0, 0.55
local TELEPORT_PICKUP_Y, TELEPORT_NUDGE_DISTANCE, TELEPORT_NUDGE_PERIOD = -0.5, 1.25, 0.8
local FULL_AFTER_MISSES = 4
local Farm = {phase = "off", note = "farm off", target = nil, targetAt = 0, arrivedAt = nil, skip = {}, pending = {}, collected = 0, roundCollected = 0, misses = 0,
    under = false, fullRound = nil, fullStarted = false, killAt = -100, kills = 0}
function Farm.setNote(phase, note) Farm.phase, Farm.note = phase, note end
function Farm.dangerAt(p)
    if Game.imMurderer or Settings.avoid <= 0 then return false end
    for _, m in ipairs(Game.murderers) do if (m - p).Magnitude < Settings.avoid then return true end end
    return false
end
function Farm.nearestOther(p)
    local best = math.huge
    for _, o in ipairs(Game.others) do local d = (o - p).Magnitude if d < best then best = d end end
    return best
end
function Farm.pick(here)
    local best, bestScore, t = nil, nil, now()
    for _, c in ipairs(Game.coins()) do
        if not (Farm.skip[c] and Farm.skip[c] > t) and not Farm.dangerAt(c.Position) then
            local d = (c.Position - here).Magnitude
            local score = d
            if Settings.farFromPlayers then
                local od = Farm.nearestOther(c.Position)
                if od <= d then score = 10000 + (d - od) end
            end
            if not bestScore or score < bestScore then best, bestScore = c, score end
        end
    end
    return best
end
function Farm.routeTo(coin)
    local _, hrp = myChar()
    local here, p = hrp.Position, coin.Position
    if Settings.flightMode == "teleport" then
        return Mover.warp(p + Vector3.new(0, TELEPORT_PICKUP_Y, 0), false)
    elseif Settings.underRoute then
        local goal = p - Vector3.new(0, Settings.prone and 1.2 or 2.5, 0)
        local travelY = p.Y - 7.8
        Mover.go({Vector3.new(here.X, math.min(here.Y, travelY), here.Z), Vector3.new(goal.X, travelY, goal.Z), goal}, Settings.prone)
    else
        Mover.go({p + Vector3.new(0, 0.5, 0)}, Settings.prone)
    end
end
-- Move around the coin along the avatar's existing facing direction without rotating it.
function Farm.teleportNudge(coin, elapsed)
    local _, root, hum = myChar()
    local guard = Mover.guard
    if not root or not hum or hum.Health <= 0 or not guard or guard.root ~= root
        or not Mover.path or not Mover.arrived or not Game.coinLive(coin) then return false end
    local offset = TELEPORT_NUDGE_DISTANCE * math.sin(elapsed * 2 * math.pi / TELEPORT_NUDGE_PERIOD)
    local forward = Vector3.new(-math.sin(Mover.yaw), 0, -math.cos(Mover.yaw))
    local position = coin.Position + Vector3.new(0, TELEPORT_PICKUP_Y, 0) + forward * offset
    -- Heartbeat applies this position; update the guard to the same destination.
    Mover.pos, guard.position = position, position
    return true
end
function Farm.touch(coin)
    local _, hrp = myChar()
    if type(firetouchinterest) ~= "function" or not hrp then return end
    pcall(firetouchinterest, hrp, coin, 0)
    pcall(firetouchinterest, hrp, coin, 1)
end
function Farm.underY(here)
    local y = here.Y - VOID_GAP
    local bottom = Game.mapBottom()
    if bottom then y = math.min(y, bottom - VOID_GAP) end
    for _, s in ipairs(Game.spawnParts()) do y = math.min(y, s.Position.Y - VOID_GAP) end
    local killY = try(function() return workspace.FallenPartsDestroyHeight end) or -500
    return math.max(y, VOID_MIN, killY + 30)
end
function Farm.goUnder()
    local _, hrp = myChar()
    if not hrp then return end
    local here = hrp.Position
    local y = Farm.underY(here)
    Log.add(string.format("going under the map to y %.1f (kill height %s)", y, tostring(try(function() return workspace.FallenPartsDestroyHeight end))))
    Mover.go({Vector3.new(here.X, math.min(y, here.Y), here.Z)}, false)
    Farm.under, Farm.underAtY = true, math.floor(math.min(y, here.Y))
end
-- The park state belongs to the current character, map and round only.
function Farm.parkValid(state, root)
    return state and root and state.root == root and Mover.guard
        and Mover.guard.root == root and (root.Position - state.anchor).Magnitude <= 12
        and state.model and state.model:IsDescendantOf(workspace)
        and (state.kind ~= "roundLobby" or (state.map == Game.map and state.cc == Game.cc
            and state.cc and state.cc.Parent))
end
function Farm.releasePark(restore)
    local state = Farm.parkState
    if not state then return end
    local _, root, hum = myChar()
    local valid = Farm.parkValid(state, root)
    Farm.parkState, Game.roundHold = nil, nil
    Mover.stop()
    if restore and valid and hum and hum.Health > 0 then
        root.CFrame = state.origin
        root.AssemblyLinearVelocity = Vector3.zero
    end
end
function Farm.park(kind, model)
    local _, root, hum = myChar()
    if not root or not hum or hum.Health <= 0 or not model or not model:IsDescendantOf(workspace) then return false end
    local previous = Farm.parkState
    if previous and previous.kind == kind and previous.model == model and Farm.parkValid(previous, root) then return true end
    local origin = previous and Farm.parkValid(previous, root) and previous.origin or root.CFrame
    if kind == "roundLobby" and previous and previous.kind == "lobby" then return false end
    Farm.releasePark(false)
    local cf, size = Game.bounds(model)
    local center, bottom
    if cf and size then
        center = cf.Position
        local extent = (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y
            + math.abs(cf.LookVector.Y) * size.Z) / 2
        bottom = center.Y - extent
    end
    if not center or not bottom then return false end
    local killY = try(function() return workspace.FallenPartsDestroyHeight end) or -500
    local y = math.max(bottom - VOID_GAP, killY + 30)
    -- Do not enter a location that is below the destruction plane or not below the structure.
    if y >= bottom - 3 then return false end
    local anchor = Vector3.new(center.X, y, center.Z)
    if kind == "underMap" then anchor = Vector3.new(root.Position.X, y, root.Position.Z) end
    if not Mover.warp(anchor, false) then return false end
    local state = {kind = kind, model = model, root = root, anchor = anchor, origin = origin,
        map = Game.map, cc = Game.cc}
    Farm.parkState = state
    if kind == "roundLobby" or kind == "underMap" then Game.roundHold = state end
    return true
end
function Farm.surface()
    local _, hrp = myChar()
    local sp = Game.spawnPos()
    Mover.stop()
    if hrp and sp then pcall(function() hrp.CFrame = CFrame.new(sp + Vector3.new(0, 3, 0)) end) end
    Farm.under = false
end
local VIM = game:GetService("VirtualInputManager")
local function tapKey(key)
    pcall(function() VIM:SendKeyEvent(true, key, false, game) end)
    task.wait(0.1)
    pcall(function() VIM:SendKeyEvent(false, key, false, game) end)
end
function Farm.kill(char, hum, attempt)
    pcall(function() hum.Health = 0 end)
    pcall(function() hum:TakeDamage(math.huge) end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
    if attempt >= 2 then
        Log.add("reset: dropping below the kill height")
        local killY = try(function() return workspace.FallenPartsDestroyHeight end) or -500
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then pcall(function() hrp.CFrame = CFrame.new(hrp.Position.X, killY - 50, hrp.Position.Z) end) end
        pcall(function() char:BreakJoints() end)
        local head = char:FindFirstChild("Head")
        if head then pcall(function() head:Destroy() end) end
    end
    if attempt >= 3 then
        Log.add("reset: using Esc + R + Enter")
        tapKey(Enum.KeyCode.Escape) task.wait(0.6)
        tapKey(Enum.KeyCode.R) task.wait(0.4)
        tapKey(Enum.KeyCode.Return)
    end
end
function Farm.afterFull(hrp, hum)
    if Farm.fullRound ~= Game.roundId then
        Farm.fullRound, Farm.fullStarted, Farm.killAt, Farm.kills = Game.roundId, false, -100, 0
        Farm.target = nil
        Session.stats.fullBags = Session.stats.fullBags + 1
        Log.add("bag full (" .. Game.bag .. ")")
    end
    local mode = Settings.afterFull
    if mode == "reset" then
        Mover.stop()
        if now() - Farm.killAt >= 3 then
            Farm.killAt, Farm.kills = now(), Farm.kills + 1
            Farm.kill(hrp.Parent, hum, Farm.kills)
        end
        Farm.setNote("full", "bag full, resetting")
    elseif mode == "spawn" then
        if not Farm.fullStarted then
            Farm.fullStarted = true
            local sp = Game.spawnPos()
            if sp then Mover.go({sp + Vector3.new(0, 3, 0)}, false) else Mover.stop() end
        end
        if Mover.path and Mover.arrived then Mover.stop() end
        Farm.setNote("full", Mover.path and "bag full, flying to spawn" or "bag full, at spawn")
    elseif mode == "xp" then
        if not Farm.fullStarted then Farm.fullStarted = true Farm.goUnder() end
        Farm.setNote("holding", "bag full, holding under the map at y " .. tostring(Farm.underAtY or "?"))
    else
        Mover.stop()
        Farm.setNote("full", "bag full")
    end
    return 0
end
function Farm.step()
    FarmAnimation.update()
    if not Settings.farm then
        Game.roundTransit = nil
        if Farm.phase ~= "off" then
            if Farm.parkState then Farm.releasePark(true) end
            Farm.teleportReturnAt = nil
            if Farm.under and Game.inRound then Farm.surface() else Mover.stop() end
            Farm.target, Farm.under = nil, false
            Farm.setNote("off", "farm off")
        end
        return 0.25
    end
    local _, hrp, hum = myChar()
    if not (hrp and hum and hum.Health > 0) then
        Game.roundTransit = nil
        Farm.releasePark(false)
        Farm.teleportReturnAt, Farm.seenCoinRound, Farm.nextTeleportAt, Farm.arrivedAt = nil, nil, nil, nil
        Farm.arrivalBag, Farm.arrivalGain = nil, nil
        Mover.stop()
        Mover.path, Farm.target, Farm.under = nil, nil, false
        Farm.setNote("waiting", "waiting to respawn")
        return 0
    end
    if Farm.lastFlightMode and Farm.lastFlightMode ~= Settings.flightMode then
        if Farm.parkState then Farm.releasePark(true) else Mover.stop() end
        Farm.target, Farm.arrivedAt, Farm.teleportReturnAt, Farm.nextTeleportAt = nil, nil, nil, nil
    end
    Farm.lastFlightMode = Settings.flightMode
    local park = Farm.parkState
    if park and not Farm.parkValid(park, hrp) then Farm.releasePark(false) end
    park = Farm.parkState
    if not Game.inRound then
        Game.roundTransit = nil
        Farm.teleportReturnAt, Farm.nextTeleportAt, Farm.arrivedAt = nil, nil, nil
        Farm.arrivalBag, Farm.arrivalGain = nil, nil
        Farm.target, Farm.under, Farm.skip, Farm.pending = nil, false, {}, {}
        Farm.roundCollected, Farm.misses = 0, 0
        if park and park.kind == "roundLobby" then Farm.releasePark(false) park = nil end
        if Game.preMap and Settings.hideUnderMap then
            if Farm.park("underMap", Game.preMap) then
                Farm.setNote("waiting", "under map, waiting for coins")
                return 0.1
            end
        elseif Settings.hideLobby
            and (Game.isLobbyPosition(hrp.Position) == true or (park and park.kind == "lobby")) then
            if Farm.park("lobby", Game.lobbyModel()) then
                Farm.setNote("waiting", "hiding under lobby")
                return 0.1
            end
        end
        if park then Farm.releasePark(park.kind == "lobby" and not Game.preMap or park.kind == "underMap") end
        if Mover.path then Mover.stop() end
        Farm.setNote("waiting", Game.cc and "waiting (you're in the lobby)" or "waiting for a round")
        return 0
    end
    if park and park.kind == "lobby" then Farm.releasePark(false) park = nil end
    if park and park.kind == "roundLobby" and Settings.flightMode ~= "teleport" then
        Farm.releasePark(true)
        return 0.05
    end
    if Game.full then
        if Farm.parkState then Farm.releasePark(true) end
        Farm.teleportReturnAt = nil
        return Farm.afterFull(hrp, hum)
    end
    local t = now()
    local teleport = Settings.flightMode == "teleport"
    if Farm.teleportReturnAt then
        if teleport and t < Farm.teleportReturnAt then return 0.03 end
        Farm.teleportReturnAt = nil
        if teleport and Farm.park("roundLobby", Game.lobbyModel()) then
            Farm.nextTeleportAt = t + TELEPORT_PARK_DWELL
            Farm.setNote("searching", "under lobby between coin pickups")
            return 0.1
        end
    end
    if not Settings.hideUnderMap and Farm.parkState and Farm.parkState.kind == "underMap" then
        Farm.releasePark(true)
        return 0.05
    end
    if Settings.hideUnderMap and Farm.seenCoinRound ~= Game.roundId and not Farm.target then
        if #Game.coins() == 0 then
            if Farm.park("underMap", Game.map) then
                Farm.setNote("waiting", "under map, waiting for coins")
                return 0.1
            end
            Farm.setNote("waiting", "no valid under-map location yet")
            return 0.25
        else
            Farm.seenCoinRound = Game.roundId
        end
    end
    for c, at in pairs(Farm.pending) do
        if not Game.coinLive(c) then
            Farm.pending[c], Farm.collected, Farm.misses = nil, Farm.collected + 1, 0
            Farm.roundCollected = Farm.roundCollected + 1
        elseif t - at > PICKUP_RETRY then
            Farm.pending[c], Farm.misses = nil, Farm.misses + 1
            if Farm.misses >= FULL_AFTER_MISSES and (Game.bag > 0 or Game.roundGain > 0 or Farm.roundCollected > 0) and not Game.pickupsStopped then
                Game.pickupsStopped = true
                Log.add("bag full: " .. Farm.misses .. " coins in a row didn't count")
            end
        end
    end
    local tgt = Farm.target
    if teleport and tgt then
        if not Mover.arrived then return 0.05 end
        if not Farm.arrivedAt then
            Farm.arrivedAt = t
            Farm.arrivalBag = Farm.arrivalBag or Game.bag
            Farm.arrivalGain = Farm.arrivalGain or Game.roundGain
        end
        local elapsed = t - Farm.arrivedAt
        local gone = not Game.coinLive(tgt)
        local credited = Game.bag > (Farm.arrivalBag or 0) or Game.roundGain > (Farm.arrivalGain or 0)
        if not gone and not credited and elapsed >= 0.25 and Farm.pickupAttempted ~= tgt then
            Farm.pickupAttempted = tgt
            Farm.touch(tgt)
        end
        if not gone and not credited and elapsed < TELEPORT_MAX_DWELL then
            if Farm.teleportNudge(tgt, elapsed) then
                Farm.setNote("farming", "waiting for coin pickup confirmation")
                return 0.05
            end
            -- If the game interrupted the movement, don't keep nudging a stale target.
            Farm.skip[tgt], Farm.target, Farm.arrivedAt = t + PICKUP_RETRY, nil, nil
            Farm.arrivalBag, Farm.arrivalGain = nil, nil
            Farm.teleportReturnAt = t
            return 0.05
        end
        if elapsed < TELEPORT_MIN_DWELL then return 0.05 end
        if credited then
            Farm.collected, Farm.roundCollected = Farm.collected + 1, Farm.roundCollected + 1
        end
        Farm.skip[tgt], Farm.target, Farm.arrivedAt = t + PICKUP_RETRY, nil, nil
        Farm.arrivalBag, Farm.arrivalGain = nil, nil
        Farm.teleportReturnAt = t
        return 0.05
    end
    if tgt then
        local skipFor
        if not Game.coinLive(tgt) then skipFor = 30
        elseif Farm.dangerAt(tgt.Position) then skipFor = 3
        elseif Settings.farFromPlayers and Farm.nearestOther(tgt.Position) + 2 < (tgt.Position - hrp.Position).Magnitude then skipFor = 5
        elseif t - Farm.targetAt > 30 then skipFor = 20
        elseif Mover.arrived then
            Farm.touch(tgt)
            Farm.pending[tgt] = t
            skipFor = PICKUP_RETRY
        end
        if skipFor then
            Farm.skip[tgt], Farm.target = t + skipFor, nil
            if teleport then
                -- Allow the contact to be processed, then return to the round parking spot.
                Farm.teleportReturnAt = t + (Farm.pending[tgt] and 0.18 or 0)
                return 0.03
            end
        else
            Farm.setNote("farming", plural(Farm.collected, "coin", "coins") .. " collected")
            return 0
        end
    end
    if teleport and not Farm.parkState then
        if not Farm.park("roundLobby", Game.lobbyModel()) then
            Mover.stop()
            Farm.setNote("waiting", "waiting for a valid lobby parking location")
            return 0.25
        end
        Farm.nextTeleportAt = t + TELEPORT_PARK_DWELL
        return 0.1
    end
    if teleport and Farm.nextTeleportAt and t < Farm.nextTeleportAt then return 0.05 end
    local searchPosition = Farm.parkState and Farm.parkState.origin.Position or hrp.Position
    local coin = Farm.pick(searchPosition)
    if not coin then
        Farm.setNote("searching", Farm.parkState and Farm.parkState.kind == "underMap"
            and "under map, waiting for a coin" or "no safe coin yet")
        return 0.1
    end
    local leavingUnderMap = Farm.parkState and Farm.parkState.kind == "underMap"
    if Farm.parkState then Farm.releasePark(false) end
    if leavingUnderMap then
        Game.roundTransit = {root = hrp, cc = Game.cc, map = Game.map,
            deadline = t + math.max(30, (coin.Position - hrp.Position).Magnitude / math.max(Settings.speed, 1) * 3 + 10)}
    end
    Farm.target, Farm.targetAt, Farm.arrivedAt, Farm.under = coin, t, nil, false
    Farm.arrivalBag, Farm.arrivalGain = Game.bag, Game.roundGain
    Farm.pickupAttempted = nil
    if Farm.routeTo(coin) == false then
        Game.roundTransit = nil
        Farm.target, Farm.arrivedAt = nil, nil
        Farm.skip[coin] = t + PICKUP_RETRY
        return 0.1
    end
    Farm.setNote("farming", plural(Farm.collected, "coin", "coins") .. " collected")
    return 0
end

local PathESP = {folder = nil, lines = {}, elapsed = 0}
function PathESP.clear()
    if PathESP.folder then PathESP.folder:Destroy() end
    PathESP.folder, PathESP.anchor, PathESP.lines = nil, nil, {}
end
function PathESP.ensure()
    if PathESP.folder and PathESP.folder.Parent then return end
    PathESP.clear()
    local folder = Instance.new("Folder")
    folder.Name = "MM2HubPathVisual"
    PathESP.folder = folder
    folder.Parent = workspace
    local anchor = Instance.new("Part")
    anchor.Name = "RouteOrigin"
    anchor.Size = Vector3.new(0.1, 0.1, 0.1)
    anchor.CFrame = CFrame.new()
    anchor.Anchored, anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = true, false, false, false
    anchor.Transparency, anchor.CastShadow = 1, false
    anchor.Parent = folder
    PathESP.anchor = anchor
end
function PathESP.line(index, from, to)
    local delta = to - from
    if delta.Magnitude < 0.03 then return false end
    local line = PathESP.lines[index]
    if not line then
        line = Instance.new("LineHandleAdornment")
        line.Name = "RouteSegment"
        line.Adornee = PathESP.anchor
        line.AlwaysOnTop, line.ZIndex = true, 2
        line.Thickness = 6
        line.Color3 = Color3.fromRGB(255, 255, 48)
        line.Transparency = 0
        line.Parent = PathESP.folder
        PathESP.lines[index] = line
    end
    line.CFrame = PathESP.anchor.CFrame:ToObjectSpace(CFrame.lookAt(from, to))
    line.Length, line.Visible = delta.Magnitude, true
    return true
end
-- Draw a transparent, twelve-edge box around the coin using the same
-- always-on-top line adornments as the route.
function PathESP.box(target, count)
    local half = target.Size / 2 + Vector3.new(0.15, 0.15, 0.15)
    local cf = target.CFrame
    local corners = {}
    for x = 0, 1 do
        for y = 0, 1 do
            for z = 0, 1 do
                local index = 1 + x * 4 + y * 2 + z
                corners[index] = cf:PointToWorldSpace(Vector3.new(
                    (2 * x - 1) * half.X, (2 * y - 1) * half.Y, (2 * z - 1) * half.Z))
            end
        end
    end
    for i = 0, 7 do
        for _, stride in ipairs({1, 2, 4}) do
            if math.floor(i / stride) % 2 == 0 then
                if PathESP.line(count + 1, corners[i + 1], corners[i + stride + 1]) then
                    count = count + 1
                end
            end
        end
    end
    return count
end
function PathESP.step(dt)
    local target = Farm.target
    local _, root, hum = myChar()
    if not Session.alive or not Settings.pathfindingESP or not Settings.farm or not Game.inRound
        or not root or not hum or hum.Health <= 0 or not target or not Game.coinLive(target)
        or not Mover.path then
        if PathESP.folder then PathESP.clear() end
        return
    end
    PathESP.elapsed = PathESP.elapsed + dt
    if PathESP.folder and PathESP.folder.Parent and PathESP.elapsed < 1 / 20 then return end
    PathESP.elapsed = 0
    PathESP.ensure()
    local from, count = root.Position, 0
    for i = Mover.i, #Mover.path do
        local point = Mover.path[i]
        if PathESP.line(count + 1, from, point) then count = count + 1 end
        from = point
    end
    -- Include the selected coin itself when the configured movement ends just above or below it.
    if PathESP.line(count + 1, from, target.Position) then count = count + 1 end
    count = PathESP.box(target, count)
    for i = count + 1, #PathESP.lines do PathESP.lines[i].Visible = false end
end
bind(RunService.Heartbeat, function(dt)
    local ok, err = pcall(PathESP.step, dt)
    if not ok then
        PathESP.clear()
        if now() - (PathESP.lastErrorAt or -100) > 5 then
            PathESP.lastErrorAt = now()
            Log.warn("Pathfinding ESP: " .. tostring(err))
        end
    end
end)

