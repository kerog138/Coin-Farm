local function addHubLogo(side)
    local holder = create("Frame", {Name = "HubLogo", LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 90),
        BackgroundTransparency = 1, Parent = side})
    local getAsset = type(getcustomasset) == "function" and getcustomasset
        or type(getsynasset) == "function" and getsynasset or nil
    if getAsset and type(writefile) == "function" then
        local ok, asset = pcall(function()
            local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local lookup, chunks = {}, {}
            for i = 1, #alphabet do lookup[alphabet:byte(i)] = i - 1 end
            for i = 1, #HUB_LOGO_PNG, 4 do
                local a, b, c, d = HUB_LOGO_PNG:byte(i, i + 3)
                a, b = lookup[a], lookup[b]
                chunks[#chunks + 1] = string.char(a * 4 + math.floor(b / 16))
                if c ~= 61 then
                    c = lookup[c]
                    chunks[#chunks + 1] = string.char((b % 16) * 16 + math.floor(c / 4))
                    if d ~= 61 then chunks[#chunks + 1] = string.char((c % 4) * 64 + lookup[d]) end
                end
            end
            ensureFolder()
            local path = FOLDER .. "/hub-logo-v1.png"
            if type(isfile) ~= "function" or not isfile(path) then writefile(path, table.concat(chunks)) end
            return getAsset(path)
        end)
        if ok and asset then
            UI.logoSource = create("ImageLabel", {Name = "MM2HubArtwork", BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Fit,
                Image = asset, Parent = holder})
            return
        end
    end
    local editable
    local ok = pcall(function()
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local lookup = {}
        for i = 1, #alphabet do lookup[alphabet:byte(i)] = i - 1 end
        local pixels = buffer.create(128 * 96 * 4)
        local at = 0
        for i = 1, #HUB_LOGO_BASE64, 4 do
            local a, b, c, d = HUB_LOGO_BASE64:byte(i, i + 3)
            a, b, c, d = lookup[a], lookup[b], lookup[c], lookup[d]
            buffer.writeu8(pixels, at, a * 4 + math.floor(b / 16))
            buffer.writeu8(pixels, at + 1, (b % 16) * 16 + math.floor(c / 4))
            buffer.writeu8(pixels, at + 2, (c % 4) * 64 + d)
            at = at + 3
        end
        assert(at == 128 * 96 * 4, "Logo data is incomplete")
        editable = game:GetService("AssetService"):CreateEditableImage({Size = Vector2.new(128, 96)})
        assert(editable, "EditableImage is unavailable")
        editable:WritePixelsBuffer(Vector2.zero, Vector2.new(128, 96), pixels)
        local image = create("ImageLabel", {Name = "MM2HubArtwork", BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Fit,
