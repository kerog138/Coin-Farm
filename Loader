        local function decodeArtwork(encoded)
            local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local lookup, chunks = {}, {}
            for i = 1, #alphabet do lookup[alphabet:byte(i)] = i - 1 end
            for i = 1, #encoded, 4 do
                local a, b, c, d = encoded:byte(i, i + 3)
                a, b = lookup[a], lookup[b]
                if c == 61 then
                    chunks[#chunks + 1] = string.char(a * 4 + math.floor(b / 16))
                else
                    c = lookup[c]
                    local first = a * 4 + math.floor(b / 16)
                    local second = (b % 16) * 16 + math.floor(c / 4)
                    if d == 61 then
                        chunks[#chunks + 1] = string.char(first, second)
                    else
                        chunks[#chunks + 1] = string.char(first, second, (c % 4) * 64 + lookup[d])
                    end
                end
            end
            return table.concat(chunks)
        end
        local function validArtwork(bytes)
            return type(bytes) == "string" and #bytes >= 45
                and bytes:sub(1, 8) == "\137PNG\r\n\26\n"
                and bytes:sub(-12) == "\0\0\0\0IEND\174B\96\130"
        end
        local function restoreArtwork()
            if not hasFiles or type(isfolder) ~= "function" or type(makefolder) ~= "function" then return end
            local ok = pcall(function()
                ensureFolder()
                if not isfolder(FOLDER .. "/art") then makefolder(FOLDER .. "/art") end
            end)
            if not ok then return end
            local count = 0
            for name, encoded in pairs(embeddedArt) do
                local path = FOLDER .. "/art/" .. name .. ".png"
                if not validArtwork(readFile(path)) then
                    local restored = pcall(function() writefile(path, decodeArtwork(encoded)) end)
                    if not restored then Log.warn("Could not restore artwork: " .. name) end
                end
                count = count + 1
                if count % 5 == 0 then task.wait() end
            end
        end
