local ROUND_GONE_AFTER = 3
function Game.update()
    local cc, map = Game.findContainer()
    if cc then
        Game.goneAt = nil
    elseif Game.cc then
        Game.goneAt = Game.goneAt or now()
        if now() - Game.goneAt < ROUND_GONE_AFTER then cc, map = Game.cc, Game.map end
    end
    if cc ~= Game.cc then
        Game.roundTransit = nil
        if Game.cc then Game.roundEnd() end
        Game.cc, Game.map = cc, map
        Game.bag, Game.full, Game.bagFull, Game.roundGain = 0, false, false, 0
        Game.startBal, Game.startSrc, Game.pickupsStopped = nil, nil, false
        if cc then
            Game.roundId, Game.roundAt = Game.roundId + 1, now()
            Session.stats.roundBag = 0
            Log.add("round on " .. map.Name)
        end
    end
    local _, hrp, hum = myChar()
    local inRound = false
    if cc and cc.Parent and hrp and hum and hum.Health > 0 then
        local here = hrp.Position
        -- Unknown lobby or map state must not trigger movement.
        inRound = Game.isLobbyPosition(here) == false and Game.isMapPosition(here, map)
        -- A deliberate round parking location must not be mistaken for an actual lobby spawn.
        local hold = Game.roundHold
        if not inRound and Settings.farm and hold and hold.root == hrp
            and (hold.map == map or (hold.kind == "underMap" and hold.model == map))
            and (hold.cc == cc or (hold.kind == "underMap" and hold.cc == nil))
            and (here - hold.anchor).Magnitude <= 12 then
            inRound = true
        end
    end
    local transit = Game.roundTransit
    if transit then
        local valid = Settings.farm and hrp and hum and hum.Health > 0 and transit.root == hrp
            and cc and cc.Parent and transit.cc == cc and transit.map == map
            and map:IsDescendantOf(workspace) and now() < transit.deadline
            and Game.isLobbyPosition(hrp.Position) == false
        if not valid or inRound then
            Game.roundTransit = nil
        else
            inRound = true
        end
    end
    Game.inRound = inRound
    Game.preMap = nil
    if not (cc and cc.Parent) and Settings.farm and Settings.hideUnderMap and hrp and hum and hum.Health > 0 then
        local hold = Game.roundHold
        if hold and hold.kind == "underMap" and hold.root == hrp and hold.model
            and hold.model:IsDescendantOf(workspace) and (hrp.Position - hold.anchor).Magnitude <= 12 then
            Game.preMap = hold.model
        else
            Game.preMap = Game.earlyMap(hrp.Position)
        end
    end
    local murderers, others = {}, {}
    local murdererPlayer, sheriffPlayer
    Game.imMurderer = false
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local knife = cc ~= nil and hasKnife(p, char)
        if p == LocalPlayer then
            Game.imMurderer = knife
        elseif root then
            if knife then
                murderers[#murderers + 1] = root.Position
                murdererPlayer = murdererPlayer or p
            end
            if cc ~= nil and not sheriffPlayer and hasGun(p, char) then sheriffPlayer = p end
            others[#others + 1] = root.Position
        end
    end
    Game.murderers, Game.others = murderers, others
    Game.murdererPlayer, Game.sheriffPlayer = murdererPlayer, sheriffPlayer
    if cc and cc.Parent then
        Game.readBag()
        local bal, src = readBalance()
        if bal then
            if not Game.startBal or src ~= Game.startSrc or bal < Game.startBal then Game.startBal, Game.startSrc = bal - Game.roundGain, src end
            Game.roundGain = math.max(Game.roundGain, bal - Game.startBal)
            Session.stats.roundBag = math.max(Session.stats.roundBag, Game.roundGain)
        end
        Game.full = Game.bagFull or Game.roundGain >= Game.bagCap() or Game.pickupsStopped
    end
    Game.note = Game.preMap and ("round loading on " .. Game.preMap.Name)
        or (not cc and "lobby" or (inRound and ("round on " .. map.Name) or "in the lobby, round running"))
end

local Mover = {path = nil, i = 0, pos = nil, v = 0, arrived = false, yaw = 0, prone = false, collide = {}}
local ACCEL = 65
local LAY_TILT = CFrame.Angles(math.rad(-90), 0, 0)
function Mover.cancelTween()
    if Mover.tween then Mover.tween:Cancel() Mover.tween:Destroy() end
    if Mover.tweenValue then Mover.tweenValue:Destroy() end
    Mover.tween, Mover.tweenValue, Mover.tweenSpeed = nil, nil, nil
end
function Mover.go(points, prone)
    local _, hrp = myChar()
    if not hrp then return false end
    if Settings.flightMode == "teleport" then prone = false end
    if not Mover.path then
        local lv = hrp.CFrame.LookVector
        if math.abs(lv.Y) < 0.9 then Mover.yaw = math.atan2(-lv.X, -lv.Z) end
        Mover.pos, Mover.v = hrp.Position, 0
    end
    Mover.cancelTween()
    Mover.guard = nil
    Mover.path, Mover.i, Mover.prone, Mover.arrived = points, 1, prone, false
    return true
end
function Mover.restoreCollision()
    for part, v in pairs(Mover.collide) do if part.Parent then pcall(function() part.CanCollide = v end) end end
    Mover.collide = {}
end
function Mover.stop()
    Mover.guard = nil
    Mover.cancelTween()
    if not Mover.path then return end
    Mover.path, Mover.v = nil, 0
    local _, hrp, hum = myChar()
    if hrp then
        local bv = hrp:FindFirstChild("_hub_bv")
        if bv then bv:Destroy() end
        pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, Mover.yaw, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
    end
    if hum then pcall(function() hum.PlatformStand = false hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    Mover.restoreCollision()
end
-- Immediate movement with an external-position guard: release if the game moves the character.
function Mover.warp(position, prone)
    if Settings.flightMode == "teleport" then prone = false end
    local _, root, hum = myChar()
    if not root or not hum or hum.Health <= 0 then return false end
    if not Mover.go({position}, prone) then return false end
    Mover.pos, Mover.i, Mover.arrived, Mover.v = position, 2, true, 0
    local cf = CFrame.new(position) * CFrame.Angles(0, Mover.yaw, 0)
    if prone then cf = cf * LAY_TILT end
    root.CFrame = cf
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    hum.PlatformStand = prone
    Mover.guard = {root = root, position = position}
    return true
end
bind(RunService.Heartbeat, function(dt)
    if not Mover.path then Mover.cancelTween() return end
    local _, hrp, hum = myChar()
    if not hrp then Mover.cancelTween() return end
    local guard = Mover.guard
    if guard and (guard.root ~= hrp or not hum or hum.Health <= 0
        or (hrp.Position - guard.position).Magnitude > 20) then
        Game.roundHold = nil
        Mover.stop()
        return
    end
    if not hrp:FindFirstChild("_hub_bv") then
        local bv = Instance.new("BodyVelocity")
        bv.Name, bv.Velocity, bv.MaxForce = "_hub_bv", Vector3.zero, Vector3.new(9e8, 9e8, 9e8)
        bv.Parent = hrp
    end
    Mover.pos = Mover.pos or hrp.Position
    local goal = Mover.path[Mover.i]
    if goal then
        -- Keep the prone body horizontal and point its head along the route.
        -- On vertical legs, look ahead to the next horizontal segment.
        if Mover.prone then
            local from = Mover.pos
            for i = Mover.i, #Mover.path do
                local point = Mover.path[i]
                local delta = point - from
                if delta.X * delta.X + delta.Z * delta.Z > 0.000001 then
                    Mover.yaw = math.atan2(-delta.X, -delta.Z)
                    break
                end
                from = point
            end
        end
        local top = Settings.speed
        local arrived = false
        if Settings.flightMode == "teleport" then
            Mover.cancelTween()
            arrived = true
        elseif Settings.flightMode == "tween" then
            if Mover.tween and Mover.tweenSpeed ~= top then
                Mover.pos = Mover.tweenValue.Value
                Mover.cancelTween()
            end
            if not Mover.tween then
                local dist = (goal - Mover.pos).Magnitude
                if dist <= 0.001 then
                    arrived = true
                else
                    local value = Instance.new("Vector3Value")
                    value.Value = Mover.pos
                    Mover.tweenValue, Mover.tweenSpeed = value, top
                    Mover.tween = TweenService:Create(value, TweenInfo.new(dist / top, Enum.EasingStyle.Linear), {Value = goal})
                    Mover.tween:Play()
                end
            end
            if Mover.tween then
                Mover.pos = Mover.tweenValue.Value
                arrived = Mover.tween.PlaybackState == Enum.PlaybackState.Completed
            end
            Mover.v = top
        else
            if Mover.tween then
                Mover.pos = Mover.tweenValue.Value
                Mover.cancelTween()
            end
            local dist = (goal - Mover.pos).Magnitude
            Mover.v = math.min(top, Mover.v + ACCEL * dt)
            local step = Mover.v * dt
            if dist <= 0.001 or step >= dist then
                arrived = true
            else
                Mover.pos = Mover.pos:Lerp(goal, step / dist)
            end
        end
        if arrived then
            Mover.cancelTween()
            Mover.pos = goal
            Mover.i = Mover.i + 1
            if Mover.i > #Mover.path then Mover.arrived = true end
        end
    end
    if Settings.flightMode == "teleport" then Mover.prone = false end
    local cf = CFrame.new(Mover.pos) * CFrame.Angles(0, Mover.yaw, 0)
    if Mover.prone then cf = cf * LAY_TILT end
    hrp.CFrame = cf
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    if hum and Mover.prone ~= hum.PlatformStand then hum.PlatformStand = Mover.prone end
end)
bind(RunService.Stepped, function()
    if not (Mover.path and Settings.noclip) then return end
    local char = LocalPlayer.Character
    for _, part in ipairs(char and char:GetChildren() or {}) do
        if part:IsA("BasePart") and part.CanCollide then
            if Mover.collide[part] == nil then Mover.collide[part] = true end
            part.CanCollide = false
        end
    end
end)
bind(LocalPlayer.CharacterAdded, function()
    Mover.cancelTween()
    Mover.guard, Game.roundHold, Game.roundTransit = nil, nil, nil
    Mover.path, Mover.pos, Mover.v, Mover.collide = nil, nil, 0, {}
end)

bind(RunService.Heartbeat, function()
