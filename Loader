local function coinBuyButton(view, price, balance, variant, entry)
    -- A popup may put the price and Buy button in separate sibling frames.
    -- Match the actual coin price and currency, not a single hard-coded path.
    local function visible(node)
        return shopPageVisible(node, variant)
    end
    local function nodes(root)
        local list = {root}
        for _, node in ipairs(root:GetDescendants()) do list[#list + 1] = node end
        return list
    end
    local function currency(value)
        local key = shopKey(value)
        if key == "coins" or key == "coin" or key == "coincurrency" or key == "coinprice"
            or key == "coinicon" or key == "coinsicon" or key == "coinbutton"
            or key == "buywithcoins" or key == "buycoins" or key == "coinsprice"
            or key:match("^%d+coins?$") or key:match("^coins?%d+$") then return "coins" end
        if key == "robux" or key == "rbx" or key == "robuxicon" or key == "robuxprice"
            or key == "buywithrobux" or key == "buyrobux" or key == "robuxbutton"
            or key == "candies" or key == "candy" or key == "tokens" or key == "gems"
            or key:match("^%d+robux$") or key:match("^robux%d+$") then return "other" end
    end
    local function caption(node)
        if node:IsA("TextLabel") or node:IsA("TextButton") then return node.Text end
    end
    local function currencyOf(node)
        local value = currency(node.Name) or currency(caption(node))
        for _, key in ipairs({"Currency", "CurrencyType", "CurrencyName", "CurrencyId", "CurrencyID"}) do
            local attr = node:GetAttribute(key)
            if attr ~= nil and tostring(attr) ~= "" then
                local kind = currency(attr) or "other"
                if value and kind ~= value then return "other" end
                value = kind
            end
        end
        return value
    end
    local function amount(value)
        if type(value) == "number" then return value end
        if type(value) ~= "string" then return nil end
        local s = value:lower():gsub(",", ""):gsub("%s", "")
        local digits = s:match("^(%d+)$") or s:match("^(%d+)coins?$")
            or s:match("^coins?(%d+)$")
        return digits and tonumber(digits) or nil
    end
    local function isBuy(node)
        if not node:IsA("GuiButton") then return false end
        local name, text = shopKey(node.Name), shopKey(caption(node))
        local function buyKey(k)
            return k == "buy" or k == "buybutton" or k == "purchase" or k == "purchasebutton"
                or k == "buywithcoins" or k == "buycoins"
        end
        if buyKey(name) or buyKey(text) then return true end
        for _, child in ipairs(node:GetDescendants()) do
            if visible(child) and child:IsA("TextLabel") and buyKey(shopKey(child.Text)) then return true end
        end
        -- Some currency rows are buttons themselves.
        return currencyOf(node) == "coins" and amount(caption(node)) == price
    end
