            local kind = currencyOf(node)
            if kind then
                local image = imageOf(node) or iconOf(node)
                if image and image ~= "" then
                    if kind == "coins" then coinIcons[image] = true else otherIcons[image] = true end
                end
                for _, child in ipairs(node:GetDescendants()) do
                    if visible(child) and (shopKey(child.Name) == "icon" or currencyOf(child) == kind) then
                        local icon = imageOf(child)
