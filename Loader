-- ─── LOOPS ───────────────────────────────────────────────────────────────────
local function loop(name, body)
    task.spawn(function()
        local lastErr = -10
        while Session.alive do
            local ok, delay = pcall(body)
            if not ok then
                if now() - lastErr > 5 then lastErr = now() Log.warn(name .. ": " .. tostring(delay)) end
                if name == "farm" then Farm.note = "error: " .. tostring(delay):sub(1, 90) end
                delay = 0.5
            end
            if not Session.alive then break end
            task.wait(type(delay) == "number" and delay or 0.1)
        end
    end)
end

local API = {}
function API.Unload()
    if not Session.alive then return end
    Session.alive = false
    Mover.stop()
    for _, c in ipairs(Session.conns) do pcall(function() c:Disconnect() end) end
    Session.conns = {}
    saveSettings()
    if env[NAME] == API then env[NAME] = nil end
end
