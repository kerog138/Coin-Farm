local LOADING_AUDIO_MP3_B64 = ""
local function decodeEmbeddedPng(encoded)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup, chunks = {}, {}
    for i = 1, #alphabet do lookup[alphabet:byte(i)] = i - 1 end
    for i = 1, #encoded, 4 do
        local a, b, c, d = encoded:byte(i, i + 3)
        a, b = lookup[a], lookup[b]
        chunks[#chunks + 1] = string.char(a * 4 + math.floor(b / 16))
        if c ~= 61 then
            c = lookup[c]
            chunks[#chunks + 1] = string.char((b % 16) * 16 + math.floor(c / 4))
            if d ~= 61 then chunks[#chunks + 1] = string.char((c % 4) * 64 + lookup[d]) end
        end
    end
    return table.concat(chunks)
end
local function getEmbeddedAsset(filename, encoded)
    local getAsset = type(getcustomasset) == "function" and getcustomasset
        or type(getsynasset) == "function" and getsynasset or nil
    if not (getAsset and type(writefile) == "function") then return nil end
    local ok, asset = pcall(function()
        ensureFolder()
        local path = FOLDER .. "/" .. filename
        if type(isfile) ~= "function" or not isfile(path) then writefile(path, decodeEmbeddedPng(encoded)) end
        return getAsset(path)
    end)
    return ok and asset or nil
end
