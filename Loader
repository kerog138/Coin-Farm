local function listLayout(gap, dir)
    return create("UIListLayout", {Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = dir or Enum.FillDirection.Vertical})
end
local function tween(o, secs, props, style, dir)
    TweenService:Create(o, TweenInfo.new(secs, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end
local function hover(o, normal, over)
    o.MouseEnter:Connect(function() tween(o, 0.12, {BackgroundColor3 = over}) end)
    o.MouseLeave:Connect(function() tween(o, 0.12, {BackgroundColor3 = normal}) end)
end
local function draggable(handle, target, onClick, outlineOnly)
    local dragging, moved, start, startPos, outline
    handle.InputBegan:Connect(function(i)
        if isPress(i) then dragging, moved, start, startPos = true, false, i.Position, target.Position end
    end)
    bind(UserInputService.InputChanged, function(i)
        if not dragging or not isMove(i) then return end
        local d = i.Position - start
        if d.Magnitude > 6 then moved = true end
        if moved then
            local nextPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            if outlineOnly then
                if not outline then
                    outline = create("Frame", {Name = "DragOutline", AnchorPoint = target.AnchorPoint,
                        Size = target.Size, Position = startPos, BackgroundTransparency = 1,
                        Active = false, ZIndex = 1000, Parent = target.Parent},
                        {stroke(Color3.fromRGB(0, 0, 0), 3)})
                end
                outline.Position = nextPos
            else
                target.Position = nextPos
            end
        end
    end)
    bind(UserInputService.InputEnded, function(i)
        if dragging and isPress(i) then
            dragging = false
            if outline then
                target.Position = outline.Position
                outline:Destroy()
                outline = nil
            end
            if not moved and onClick then onClick() end
        end
    end)
end

