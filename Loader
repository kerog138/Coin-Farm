        local priceFrame = try(function() return view.Container.Right.PriceFrame end)
        if coinsOnly and priceFrame and visible(priceFrame) then
            local row, rowCount = nil, 0
            for _, child in ipairs(priceFrame:GetChildren()) do
                if child:IsA("GuiObject") and visible(child) then
                    if child.Name == "CurrencyPriceFrame" then
                        row, rowCount = child, rowCount + 1
                    else
                        -- A different visible purchase layout is ambiguous.
                        rowCount = rowCount + 2
                    end
                end
            end
            if rowCount == 1 and row and priceOf(row) == price then
                local buy = row:FindFirstChild("Buy")
                local icon = try(function() return row.Container.Icon end)
                local priceLabel = try(function() return row.Container.PriceFrame.PriceLabel end)
                if buy and visible(buy) and isBuy(buy) and icon and visible(icon)
                    and imageOf(icon) and priceLabel and visible(priceLabel)
                    and amount(caption(priceLabel)) == price then
                    local _, other, priced, includes, buys = inspect(row, buy)
                    local _, frameOther, _, _, frameBuys = inspect(priceFrame, buy)
                    if not other and not frameOther and priced and includes
                        and buys == 1 and frameBuys == 1 then return buy end
