                runningTime = Stats.clock(up), candiesPerHour = Stats.perHour(total, up), candies = total,
                rounds = st.rounds, fullBags = st.fullBags, bag = Game.bag, farm = Farm.phase, map = Game.map and Game.map.Name or "lobby"}))
        end)
    end
    return 1
end)

