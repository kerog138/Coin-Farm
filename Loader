end
local SHOP_CLICK_METHODS = {"MouseButton1Click", "Activated"}
-- Executor connection proxies may throw when an optional member is read.
local function shopConnectionMember(connection, key)
    local ok, value = pcall(function() return connection[key] end)
    if ok then return value end
    return nil
end
local function shopConnectionActive(connection)
    return shopConnectionMember(connection, "Enabled") ~= false
        and shopConnectionMember(connection, "Connected") ~= false
end
local function shopSignalAvailable(button, method)
    if not button or not button:IsA("GuiButton") then return false end
    if type(getconnections) ~= "function" then return type(firesignal) == "function" end
    local ok, list = pcall(getconnections, button[method])
    if not ok or type(list) ~= "table" then return type(firesignal) == "function" end
    for _, connection in ipairs(list) do
        if shopConnectionActive(connection) then return true end
    end
    return false
end
local function shopClickBy(button, method)
    if not shopSignalAvailable(button, method) then return false end
    local signal = button[method]
    if type(firesignal) == "function" then
        return pcall(function()
            if method == "Activated" then firesignal(signal, nil, 1) else firesignal(signal) end
        end)
    end
    if type(getconnections) ~= "function" then return false end
    local ok, list = pcall(getconnections, signal)
    if not ok or type(list) ~= "table" then return false end
    local invoked = false
    for _, connection in ipairs(list) do
        local callback = shopConnectionMember(connection, "Function")
        if shopConnectionActive(connection) and type(callback) == "function" then
            local success
            if method == "Activated" then success = pcall(callback, nil, 1)
            else success = pcall(callback) end
            if success then invoked = true end
        end
    end
    return invoked
end
local function shopMethod(button, preferred)
    if preferred and shopSignalAvailable(button, preferred) then return preferred end
    for _, method in ipairs(SHOP_CLICK_METHODS) do
        if shopSignalAvailable(button, method) then return method end
    end
end
local function shopStillSelected(entry)
    return Session.alive and Settings.autoShop and Settings.shopSelected[entry.id] == true
        and Shop.selectionState(entry) == nil
end
local function shopWaitFor(test, entry, seconds)
    local deadline = now() + seconds
    repeat
        if not shopStillSelected(entry) then return nil end
        local value = test()
        if value then return value end
        task.wait(0.1)
    until now() >= deadline
    if shopStillSelected(entry) then return test() end
end
local function cardFor(variant, entry)
    local card = nativeShopCard(variant, entry.id)
    local action = card and try(function() return card.Container.ActionButton end)
    if action and action:IsA("GuiButton") and shopPageVisible(action, variant) then return action end
    local view = variant:FindFirstChild("ViewContents", true)
    local idKey, nameKey = shopKey(entry.id), shopKey(entry.name)
    local best, score = nil, 0
    local function offer(button, points)
        if not button or not button:IsA("GuiButton") or not shopPageVisible(button, variant)
            or (view and button:IsDescendantOf(view)) then return end
        local area = button.AbsoluteSize.X * button.AbsoluteSize.Y
        local bestArea = best and best.AbsoluteSize.X * best.AbsoluteSize.Y or math.huge
        if points > score or (points == score and area < bestArea) then
            best, score = button, points
        end
    end
    for _, node in ipairs(variant:GetDescendants()) do
        if view and node:IsDescendantOf(view) then continue end
        if node:IsA("GuiButton") then
            local s = shopKey(node.Name) == idKey and 5 or 0
            if node:IsA("TextButton") then
                local key = shopKey(node.Text)
                if key == idKey or key == nameKey then s = math.max(s, 4) end
            end
            for _, attribute in ipairs({"ItemID", "ItemId", "ShopItemID", "ProductID", "ItemName"}) do
                local key = shopKey(node:GetAttribute(attribute))
                if key == idKey or key == nameKey then s = math.max(s, 5) end
            end
            for _, child in ipairs(node:GetDescendants()) do
                local key
                if child:IsA("TextLabel") or child:IsA("TextButton") then key = shopKey(child.Text)
                elseif child:IsA("StringValue") then key = shopKey(child.Value) end
                if key == idKey then s = math.max(s, 3)
                elseif key == nameKey then s = math.max(s, 2) end
            end
            if s > 0 then offer(node, s) end
        elseif node:IsA("GuiObject") and (shopKey(node.Name) == idKey or shopKey(node.Name) == nameKey) then
            offer(node:FindFirstChildWhichIsA("GuiButton", true), 3.5)
        elseif node:IsA("TextLabel") or node:IsA("StringValue") then
            local value = node:IsA("StringValue") and node.Value or node.Text
            local key = shopKey(value)
            if key == idKey or key == nameKey or shopKey(node.Name) == idKey then
                local parent = node.Parent
                for depth = 1, 4 do
                    if not parent or parent == variant or parent == view then break end
                    local button = parent:IsA("GuiButton") and parent
                        or parent:FindFirstChildWhichIsA("GuiButton", true)
