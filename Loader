    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("BasePart") and (v.AssemblyLinearVelocity.Magnitude > 150 or v.AssemblyAngularVelocity.Magnitude > 150) then
            v.AssemblyLinearVelocity = Vector3.zero
            v.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

local VOID_GAP, VOID_MIN = 40, -450
local PICKUP_RETRY = 2
local FULL_AFTER_MISSES = 4
local Farm = {phase = "off", note = "farm off", target = nil, targetAt = 0, arrivedAt = nil, skip = {}, pending = {}, collected = 0, roundCollected = 0, misses = 0,
    under = false, fullRound = nil, fullStarted = false, killAt = -100, kills = 0}
function Farm.setNote(phase, note) Farm.phase, Farm.note = phase, note end
function Farm.dangerAt(p)
    if Game.imMurderer or Settings.avoid <= 0 then return false end
    for _, m in ipairs(Game.murderers) do if (m - p).Magnitude < Settings.avoid then return true end end
    return false
end
function Farm.nearestOther(p)
    local best = math.huge
    for _, o in ipairs(Game.others) do local d = (o - p).Magnitude if d < best then best = d end end
    return best
end
function Farm.pick(here)
    local best, bestScore, t = nil, nil, now()
    for _, c in ipairs(Game.coins()) do
        if not (Farm.skip[c] and Farm.skip[c] > t) and not Farm.dangerAt(c.Position) then
            local d = (c.Position - here).Magnitude
            local score = d
            if Settings.farFromPlayers then
                local od = Farm.nearestOther(c.Position)
                if od <= d then score = 10000 + (d - od) end
            end
            if not bestScore or score < bestScore then best, bestScore = c, score end
        end
    end
    return best
end
function Farm.routeTo(coin)
    local _, hrp = myChar()
    local here, p = hrp.Position, coin.Position
    if Settings.underRoute then
        local goal = p - Vector3.new(0, Settings.prone and 1.2 or 2.5, 0)
        local travelY = p.Y - 7.8
        Mover.go({Vector3.new(here.X, math.min(here.Y, travelY), here.Z), Vector3.new(goal.X, travelY, goal.Z), goal}, Settings.prone)
    else
        Mover.go({p + Vector3.new(0, 0.5, 0)}, Settings.prone)
    end
end
function Farm.touch(coin)
