function Farm.kill(char, hum, attempt)
    pcall(function() hum.Health = 0 end)
    pcall(function() hum:TakeDamage(math.huge) end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
    if attempt >= 2 then
        Log.add("reset: dropping below the kill height")
        local killY = try(function() return workspace.FallenPartsDestroyHeight end) or -500
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then pcall(function() hrp.CFrame = CFrame.new(hrp.Position.X, killY - 50, hrp.Position.Z) end) end
        pcall(function() char:BreakJoints() end)
        local head = char:FindFirstChild("Head")
        if head then pcall(function() head:Destroy() end) end
    end
    if attempt >= 3 then
        Log.add("reset: using Esc + R + Enter")
        tapKey(Enum.KeyCode.Escape) task.wait(0.6)
        tapKey(Enum.KeyCode.R) task.wait(0.4)
        tapKey(Enum.KeyCode.Return)
    end
end
function Farm.afterFull(hrp, hum)
    if Farm.fullRound ~= Game.roundId then
        Farm.fullRound, Farm.fullStarted, Farm.killAt, Farm.kills = Game.roundId, false, -100, 0
        Farm.target = nil
        Session.stats.fullBags = Session.stats.fullBags + 1
        Log.add("bag full (" .. Game.bag .. ")")
    end
    local mode = Settings.afterFull
    if mode == "reset" then
        Mover.stop()
        if now() - Farm.killAt >= 3 then
            Farm.killAt, Farm.kills = now(), Farm.kills + 1
            Farm.kill(hrp.Parent, hum, Farm.kills)
        end
        Farm.setNote("full", "bag full, resetting")
    elseif mode == "spawn" then
        if not Farm.fullStarted then
            Farm.fullStarted = true
            local sp = Game.spawnPos()
            if sp then Mover.go({sp + Vector3.new(0, 3, 0)}, false) else Mover.stop() end
        end
        if Mover.path and Mover.arrived then Mover.stop() end
        Farm.setNote("full", Mover.path and "bag full, flying to spawn" or "bag full, at spawn")
    elseif mode == "xp" then
        if not Farm.fullStarted then Farm.fullStarted = true Farm.goUnder() end
        Farm.setNote("holding", "bag full, holding under the map at y " .. tostring(Farm.underAtY or "?"))
    else
        Mover.stop()
        Farm.setNote("full", "bag full")
    end
    return 0
end
function Farm.step()
    if not Settings.farm then
        if Farm.phase ~= "off" then
            if Farm.under and Game.inRound then Farm.surface() else Mover.stop() end
            Farm.target, Farm.under = nil, false
            Farm.setNote("off", "farm off")
        end
        return 0.25
    end
    local _, hrp, hum = myChar()
    if not (hrp and hum and hum.Health > 0) then
        Mover.path, Farm.target, Farm.under = nil, nil, false
        Farm.setNote("waiting", "waiting to respawn")
        return 0
    end
    if not Game.inRound then
        if Mover.path then Mover.stop() end
        Farm.target, Farm.under, Farm.skip, Farm.pending = nil, false, {}, {}
        Farm.roundCollected, Farm.misses = 0, 0
        Farm.setNote("waiting", Game.cc and "waiting (you're in the lobby)" or "waiting for a round")
        return 0
    end
    if Game.full then return Farm.afterFull(hrp, hum) end
    local t = now()
    for c, at in pairs(Farm.pending) do
        if not Game.coinLive(c) then
            Farm.pending[c], Farm.collected, Farm.misses = nil, Farm.collected + 1, 0
            Farm.roundCollected = Farm.roundCollected + 1
        elseif t - at > PICKUP_RETRY then
            Farm.pending[c], Farm.misses = nil, Farm.misses + 1
            if Farm.misses >= FULL_AFTER_MISSES and (Game.bag > 0 or Game.roundGain > 0 or Farm.roundCollected > 0) and not Game.pickupsStopped then
                Game.pickupsStopped = true
                Log.add("bag full: " .. Farm.misses .. " candies in a row didn't count")
            end
        end
    end
    local tgt = Farm.target
    if tgt then
        local skipFor
        if not Game.coinLive(tgt) then skipFor = 30
        elseif Farm.dangerAt(tgt.Position) then skipFor = 3
        elseif Settings.farFromPlayers and Farm.nearestOther(tgt.Position) + 2 < (tgt.Position - hrp.Position).Magnitude then skipFor = 5
        elseif t - Farm.targetAt > 30 then skipFor = 20
        elseif Mover.arrived then
            Farm.touch(tgt)
            Farm.pending[tgt] = t
            skipFor = PICKUP_RETRY
        end
        if skipFor then
            Farm.skip[tgt], Farm.target = t + skipFor, nil
        else
            Farm.setNote("farming", plural(Farm.collected, "candy", "candies") .. " collected")
            return 0
        end
    end
    local coin = Farm.pick(hrp.Position)
    if not coin then
        Farm.setNote("searching", "no safe candy yet")
        return 0
    end
    Farm.target, Farm.targetAt, Farm.arrivedAt, Farm.under = coin, t, nil, false
    Farm.routeTo(coin)
    Farm.setNote("farming", plural(Farm.collected, "candy", "candies") .. " collected")
    return 0
end

