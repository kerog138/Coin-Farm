local Shop = {status = "Select coin items to buy.", busy = false, cursor = 0, boughtOnce = {}, nextAt = 0}
local function shopKey(value) return tostring(value or ""):lower():gsub("[^%w]", "") end
local function nativeShopCard(variant, id)
    local items = variant:FindFirstChild("Items", true)
    local grid = items and items:FindFirstChild("ScrollFrame", true)
    return grid and grid:FindFirstChild(id)
end
local function nativeName(id)
    for _, variant in ipairs(shopVariants()) do
        local card = nativeShopCard(variant, id)
        local label = card and try(function() return card.ItemName.TextLabel end)
        if label and label:IsA("TextLabel") and label.Text ~= "" then return label.Text end
    end
end
local function shopCategory(id, entry)
    local hint = shopKey(tostring(id) .. " " .. tostring(entry.Category or "") .. " "
        .. tostring(entry.Type or "") .. " " .. tostring(entry.ItemType or "")
        .. " " .. tostring(entry.Section or ""))
    if hint:find("egg", 1, true) then return "Eggs" end
    if hint:find("box", 1, true) or hint:find("crate", 1, true) then return "Boxes" end
    if hint:find("power", 1, true) or hint:find("perk", 1, true) then return "Powers" end
    if hint:find("emote", 1, true) or hint:find("toy", 1, true) then return "Emotes" end
    if hint:find("effect", 1, true) then return "Effects" end
    if hint:find("radio", 1, true) or hint:find("boombastic", 1, true)
        or hint:find("dubstep", 1, true) then return "Radios" end
    return nil
end
function Shop.catalog()
    local data, out = Data.shop(), {}
    if type(data) ~= "table" then return out end
    if Shop.cachedData == data and Shop.cachedCatalog then return Shop.cachedCatalog end
    for id, entry in pairs(data) do
        if type(id) == "string" and type(entry) == "table" and type(entry.Price) == "table" then
            local price = tonumber(entry.Price.Coins)
            if price and price > 0 and price < math.huge and price == math.floor(price) then
                local name = nativeName(id) or (type(entry.DisplayName) == "string" and entry.DisplayName
                    or type(entry.Name) == "string" and entry.Name or id)
                local category = shopCategory(id, entry)
                if category then
                    out[#out + 1] = {id = id, name = name, price = price, category = category,
                        repeatable = category == "Boxes" or category == "Eggs"}
                end
            end
        end
    end
    table.sort(out, function(a, b)
        if a.price ~= b.price then return a.price < b.price end
        return a.name:lower() < b.name:lower()
    end)
    Shop.cachedData, Shop.cachedCatalog = data, out
    return out
end
