    local profile = Data.profile()
    if type(profile) ~= "table" then return nil end
    local aliases = ownershipCategories[entry.category]
    if not aliases then return nil end
    local keys = {[shopKey(entry.id)] = true, [shopKey(entry.name)] = true}
    keys[""] = nil
    local loaded = false
    local function scan(root)
        if type(root) ~= "table" then return false end
        for category, inventory in pairs(root) do
            if type(category) == "string" and aliases[shopKey(category)] and type(inventory) == "table" then
                local list = inventory.Owned or inventory.owned
                if type(list) == "table" then
                    loaded = true
                    if matchOwnedList(list, keys, true) then return true end
                else
                    -- Some versions expose the category as the inventory list.
                    -- Do not interpret a category with only equipment metadata
                    -- or an empty, uninitialized table as a verified inventory.
                    if matchOwnedList(inventory, keys, true) then return true end
                end
