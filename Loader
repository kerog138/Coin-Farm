function Game.bagCap() return Game.bagMax or (Game.elite and 50) or Settings.bagSize end
local function readBagFrame(bag)
    local known = try(function() return bag.CurrencyFrame.Icon.Coins end)
    local labels = {known}
    for _, d in ipairs(bag:GetDescendants()) do
        if d ~= known and d:IsA("TextLabel") then labels[#labels + 1] = d end
    end
    local n, max
    for _, l in ipairs(labels) do
        local txt = (try(function() return l.Text end) or ""):gsub(",", "")
        local a, b = txt:match("(%d+)%s*/%s*(%d+)")
        if a then n, max = tonumber(a), tonumber(b) break end
        if not n then n = tonumber(txt:match("^%D*(%d+)%D*$") or "") end
    end
    local f = bag:FindFirstChild("Full", true)
    return n, max, (f and f:IsA("GuiObject") and f.Visible) or false
end
function Game.readBag()
    local box = try(function() return LocalPlayer.PlayerGui.MainGUI.Game.CoinBags.Container end)
    if not box then return end
    local n, max, full
    local candy = box:FindFirstChild("Candy")
    if candy and candy:IsA("GuiObject") then n, max, full = readBagFrame(candy) end
    if not n then
        for _, bag in ipairs(box:GetChildren()) do
            if bag:IsA("GuiObject") and bag.Visible then
                local bn, bmax, bf = readBagFrame(bag)
                if bn and bn > (n or -1) then n, max, full = bn, bmax, bf end
            end
        end
    end
    if n then Game.bag = n Session.stats.roundBag = math.max(Session.stats.roundBag, n) end
    if max then Game.bagMax = max end
    Game.bagFull = full or (n ~= nil and n >= Game.bagCap())
end
local BOX_PRICE = 600
local function numberIn(txt) return type(txt) == "string" and tonumber((txt:gsub("[^%d]", ""))) or nil end
local function priceOf(frame) return numberIn(try(function() return frame.Container.PriceFrame.PriceLabel.Text end)) end
local function iconOf(frame) return try(function() return frame.Container.Icon.Image end) end
local function shopVariants()
    local shop = try(function() return LocalPlayer.PlayerGui.CrossPlatform.Shop end)
    local out = {}
    for _, size in ipairs({"Medium", "Small", "Large"}) do
        local variant = shop and shop:FindFirstChild(size)
        if variant then out[#out + 1] = variant end
    end
    table.sort(out, function(a, b)
        return (try(function() return a.Visible end) and 1 or 0) > (try(function() return b.Visible end) and 1 or 0)
    end)
    return out
end
local function readBoxView(variant)
    local vc = variant:FindFirstChild("ViewContents", true)
    local view = vc and vc:FindFirstChild("Container")
    local name = view and try(function() return view.BoxFrame.ItemFrame.ItemName.TextLabel.Text end)
    if type(name) ~= "string" or not name:lower():find("halloween") then return nil end
    local priceFrame, priceIndex, n = nil, nil, 0
    for _, f in ipairs(try(function() return view.BuyFrame.PurchaseOptions:GetChildren() end) or {}) do
        if f.Name == "CurrencyPriceFrame" then
            n = n + 1
            if priceOf(f) == BOX_PRICE then priceFrame, priceIndex = f, n end
        end
    end
    if not priceFrame then return nil end
    local icon, owned, byIndex, m = iconOf(priceFrame), nil, nil, 0
    for _, f in ipairs(try(function() return view.BuyFrame.Currencies:GetChildren() end) or {}) do
        if f.Name == "OwnedCurrencyFrame" then
            m = m + 1
            if icon and icon ~= "" and iconOf(f) == icon then owned = priceOf(f) end
            if m == priceIndex then byIndex = priceOf(f) end
        end
    end
    return priceFrame:FindFirstChild("Buy"), owned or byIndex
end
local function candyBox()
    for _, variant in ipairs(shopVariants()) do
        local buy, owned = readBoxView(variant)
        if buy then return buy, owned, variant end
    end
end
