local VOTE_BEST = {"hotel", "bank2", "house2", "barn", "spaceship", "researchfacility"}
local VOTE_WORST = {"vampirecastle", "milbase", "biolab", "policestation", "factory"}
local VOTE_ALIAS = {hotel2 = "hotel", vampirescastle = "vampirecastle"}
local VOTE_LAND, VOTE_STACK_FOR, VOTE_RESPAWN = 0.15, 13, 0.5
local Vote = {sig = nil, pick = 1, pickName = nil, movedAt = -10, note = "off", openAt = -100,
    char = nil, landedAt = nil, killed = false, killedAt = -10, kills = 0, cast = 0}
local function voteScore(name)
    local k = tostring(name or ""):lower():gsub("[^%w]", "")
    k = VOTE_ALIAS[k] or k
    for i, m in ipairs(VOTE_BEST) do if m == k then return 100 - i end end
    for i, m in ipairs(VOTE_WORST) do if m == k then return -i end end
    return 0
end
function Vote.pads()
    local folder = try(function() return workspace.Lobby.VotePads end)
    if not folder then return nil end
    local out = {}
    for i = 1, 3 do
        local pad = folder:FindFirstChild("VotePad" .. i)
        local name = pad and try(function() return pad.VoteInfoGui.Container.MapName.Text end)
        local part = pad and pad:FindFirstChild("Pad")
        if not (name and part) then return nil end
        out[i] = {name = name, part = part}
    end
    return out
end
function Vote.step()
    if not Settings.autoVote then Vote.note, Vote.sig = "off", nil return 0.5 end
    local pads = Vote.pads()
    if not pads then Vote.note = "no vote pads" return 1 end
    local sig = pads[1].name .. "|" .. pads[2].name .. "|" .. pads[3].name
    if sig ~= Vote.sig then
        Vote.openAt = Vote.sig and now() or -100
        Vote.sig, Vote.pick, Vote.kills, Vote.cast = sig, 1, 0, 0
        for i = 2, 3 do if voteScore(pads[i].name) > voteScore(pads[Vote.pick].name) then Vote.pick = i end end
        Vote.pickName = pads[Vote.pick].name
        Log.add("vote: " .. sig .. " -> " .. Vote.pickName)
    end
    local char, root, hum = myChar()
    local hp = hum and hum.Health
    local t = now()
    if char ~= Vote.char then Vote.char, Vote.landedAt, Vote.killed = char, nil, false end
    if Vote.killed and hp and hp > 0 and t - Vote.killedAt > VOTE_RESPAWN then Vote.landedAt, Vote.killed = nil, false end
    local lobby = Game.lobbyPos()
    if not (root and lobby) or (root.Position - lobby).Magnitude > LOBBY_RADIUS then Vote.note = "waiting for the lobby" return 0.25 end
    local target = try(function() return pads[Vote.pick].part.Position end)
    if not target then return 0.05 end
    local here = root.Position
    if Vector3.new(here.X - target.X, 0, here.Z - target.Z).Magnitude > 3 then
        if t - Vote.movedAt > 0.2 then
            Vote.movedAt = t
            pcall(function() root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0)) end)
        end
        Vote.landedAt, Vote.note = nil, "going to " .. Vote.pickName
        return 0.05
    end
    if not Vote.landedAt and t - Vote.openAt < 17 then Vote.cast = Vote.cast + 1 end
    Vote.landedAt = Vote.landedAt or t
    Vote.note = "voting " .. Vote.pickName
    if t - Vote.openAt < VOTE_STACK_FOR and not Vote.killed and hp and hp > 0 and t - Vote.landedAt >= VOTE_LAND then
        pcall(function() hum.Health = 0 end)
        Vote.killed, Vote.killedAt, Vote.kills = true, t, Vote.kills + 1
        Vote.note = "re-voting " .. Vote.pickName .. " (" .. Vote.kills .. ")"
    end
    return 0.05
end

local Stats = {earned = 0, last = {}}
function Stats.commas(n)
    local s = tostring(math.floor(n))
    while true do local k s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2") if k == 0 then return s end end
end
function Stats.clock(s)
    s = math.max(0, math.floor(s))
    return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end
function Stats.total()
    local bal, source = readBalance()
    if bal then
        local last = Stats.last[source]
        if last and bal > last then Stats.earned = Stats.earned + (bal - last) end
        Stats.last[source] = bal
        Stats.counting = true
    end
    if Stats.counting then return Stats.earned end
    return Session.stats.candies + (Game.cc and Session.stats.roundBag or 0)
end
function Stats.perHour(total, secs)
    if secs < 1 then return 0 end
    local actualRate = total / (secs / 3600)
    return math.min(math.floor(actualRate * 5 + 0.5), 5000)
end
function Stats.rows()
    local up = now() - Session.started
    local total, st = Stats.total(), Session.stats
    local owned = readBalance()
    local rows = {
        {"Candy owned", owned and Stats.commas(owned) or "open the box once"},
        {"Running", Stats.clock(up)},
        {"Candies / hour", Stats.perHour(total, up)},
        {"Candies Total", total},
        {"Rounds", st.rounds},
        {"Full bags", st.fullBags},
        {"Bag", math.max(Game.bag, Game.roundGain or 0) .. " / " .. Game.bagCap() .. (Game.full and " (full)" or "")},
        {"Map", Game.map and Game.map.Name or "Lobby"},
    }
    if Settings.autoVote then rows[#rows + 1] = {"Voting", (Vote.pickName or "waiting") .. " x" .. Vote.cast} end
    return rows
end

local httpRequest = (type(syn) == "table" and syn.request) or (type(http) == "table" and http.request)
    or http_request or request or (type(fluxus) == "table" and fluxus.request)
local Hook = {nextAt = nil, sending = false, testAt = -math.huge, status = "nothing sent yet"}
local function commas(n)
    local s = tostring(math.floor(n))
    while true do local k s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2") if k == 0 then return s end end
end
function Hook.name() return Settings.hookName ~= "" and Settings.hookName or "MM2 Hub" end
Hook.balance = readBalance
function Hook.post(payload)
    if type(httpRequest) ~= "function" then return false, "this executor has no request()" end
    local ok, res = pcall(httpRequest, {Url = Settings.hookUrl .. "?wait=true", Method = "POST",
        Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(payload)})
    if not ok then return false, tostring(res) end
    local code = type(res) == "table" and tonumber(res.StatusCode) or 0
    if code >= 200 and code < 300 then return true end
    local data = type(res) == "table" and try(function() return HttpService:JSONDecode(res.Body) end)
    return false, tostring(type(data) == "table" and (data.message or (data.retry_after and "rate limited")) or ("HTTP " .. code)):sub(1, 120)
end
function Hook.payload(title, s, description)
    return {username = Hook.name(), allowed_mentions = {parse = {}}, embeds = {{
        title = title, description = description, color = 0x9655FF,
        fields = {
            {name = "Candies Total", value = s.balance and commas(s.balance) or "unknown", inline = true},
            {name = "Candies / Hour", value = commas(s.perHour), inline = true},
            {name = "Running Time", value = Stats.clock(s.up), inline = true},
            {name = "Full Bags", value = tostring(s.fullBags), inline = true},
            {name = "Rounds", value = tostring(s.rounds), inline = true},
        },
    }}}
end
function Hook.sendStats()
    local up, st = now() - Session.started, Session.stats
    local ok, why = Hook.post(Hook.payload(Hook.name() .. " Stats", {balance = Hook.balance(),
        perHour = Stats.perHour(Stats.total(), up), up = up, fullBags = st.fullBags, rounds = st.rounds}))
    Hook.status = ok and "stats sent" or ("failed: " .. tostring(why))
    if not ok then Log.add("webhook: " .. tostring(why)) end
    return ok
end
function Hook.sendTest()
    if Hook.sending then return end
    if not isWebhook(Settings.hookUrl) then notify("Discord", "Paste your webhook URL first.") return end
    local wait = math.ceil(5 - (now() - Hook.testAt))
    if wait > 0 then notify("Discord", "Wait " .. wait .. "s before testing again.") return end
    Hook.sending, Hook.testAt = true, now()
    task.spawn(function()
        local every = HOOK_LABELS[table.find(HOOK_TIMES, Settings.hookEvery) or 1]
        local ok, why = Hook.post(Hook.payload(Hook.name() .. " Stats (Test)", {balance = 0, perHour = 0, up = 0, fullBags = 0, rounds = 0},
            "Test message: your webhook is connected. Stats will be posted here every " .. every .. "."))
        Hook.sending = false
        Hook.status = ok and "test sent" or ("test failed: " .. tostring(why))
        notify("Discord", ok and "Test sent. The webhook works." or ("Test failed: " .. tostring(why)))
    end)
end
function Hook.step()
    if not (Settings.hookOn and isWebhook(Settings.hookUrl)) then Hook.nextAt = nil return 1 end
    local t = now()
    Hook.nextAt = Hook.nextAt or (t + Settings.hookEvery * 60)
    if t < Hook.nextAt or Hook.sending then return 1 end
    Hook.sending = true
    local ok = Hook.sendStats()
    Hook.sending = false
    if ok then
        local every, due = Settings.hookEvery * 60, Hook.nextAt
        repeat due = due + every until due > now()
        Hook.nextAt = due
    else
        Hook.nextAt = now() + 60
    end
    return 1
end

