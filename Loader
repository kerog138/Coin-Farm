                local image = imageOf(node)
                if kind == "other" or (image and otherIcons[image]) then hasOther = true end
                local inCurrencyBalance = false
                local parent = node
                while parent and parent ~= view do
                    local key = shopKey(parent.Name)
                    if key == "currencies" or key == "ownedcurrencyframe" or key == "balance" then
                        inCurrencyBalance = true break
                    end
                    parent = parent.Parent
                end
                if not inCurrencyBalance then
                    if kind == "coins" or (image and coinIcons[image] and not otherIcons[image]) then hasCoin = true end
