local function myChar()
    local char = LocalPlayer.Character
    return char, char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
end
function Game.findContainer()
    if Game.cc and Game.map and Game.cc:IsDescendantOf(Game.map)
        and Game.map:IsDescendantOf(workspace) then return Game.cc, Game.map end
    if now() - (Game.containerScanAt or -100) < 0.15 then return nil end
    Game.containerScanAt = now()
    local lobby = Game.lobbyModel()
    local candidates = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj ~= lobby and obj.Name ~= "Lobby" and (obj:IsA("Model") or obj:IsA("Folder")) then
            local cc = obj:FindFirstChild("CoinContainer", true)
            if cc and (cc:IsA("Folder") or cc:IsA("Model")) then
                local map = cc.Parent
                -- Prefer an enclosing map model with spawn points over an intermediate folder.
                local ancestor = map
                while ancestor and ancestor ~= workspace and ancestor ~= lobby do
                    if ancestor:IsA("Model") and ancestor:FindFirstChild("Spawns", true) then
                        map = ancestor
                        break
                    end
                    ancestor = ancestor.Parent
                end
                if map and map ~= lobby and map ~= workspace then
                    candidates[#candidates + 1] = {cc, map}
                end
            end
        end
    end
    if #candidates == 1 then return candidates[1][1], candidates[1][2] end
    local _, root = myChar()
    if root then
        local match
        for _, pair in ipairs(candidates) do
            if Game.isMapPosition(root.Position, pair[2]) then
                if match then return nil end
                match = pair
            end
        end
        if match then return match[1], match[2] end
    end
end
function Game.coins()
    local out, cc = {}, Game.cc
    if not (cc and cc.Parent) then return out end
    for _, c in ipairs(cc:GetChildren()) do
        if c:IsA("BasePart") then
            if c:FindFirstChild("TouchInterest") then out[#out + 1] = c end
        elseif c:IsA("Model") or c:IsA("Folder") then
            for _, c2 in ipairs(c:GetChildren()) do
                if c2:IsA("BasePart") and c2:FindFirstChild("TouchInterest") then out[#out + 1] = c2 end
            end
        end
    end
    return out
end
function Game.coinLive(c) return c.Parent ~= nil and c:FindFirstChild("TouchInterest") ~= nil end
-- Resolve the live lobby rather than keeping a position from an older map.
function Game.lobbyModel()
    local direct = workspace:FindFirstChild("Lobby")
    if direct and (direct:IsA("Model") or direct:IsA("Folder")) then return direct end
    local cached = Game.lobbyModelCache
    if cached and cached:IsDescendantOf(workspace) and now() - (Game.lobbyScanAt or 0) < 2 then return cached end
    if now() - (Game.lobbyScanAt or -100) < 1 then return nil end
    Game.lobbyScanAt, Game.lobbyModelCache = now(), nil
    local candidates = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            local key = obj.Name:lower():gsub("[^%w]", "")
            if key == "lobby" or key == "mainlobby" or key == "lobbymap" then return obj end
            if key:find("lobby", 1, true) then candidates[#candidates + 1] = obj end
            if obj:FindFirstChild("VotePads", true) then candidates[#candidates + 1] = obj end
        end
    end
    local first = candidates[1]
    if first then
        for _, obj in ipairs(candidates) do if obj ~= first then return nil end end
        Game.lobbyModelCache = first
        return first
    end
end
function Game.lobbyPos()
    local lobby = Game.lobbyModel()
    if not lobby then return nil end
    local box = lobby:FindFirstChild("Box")
    if box and box:IsA("BasePart") then return box.Position end
    if lobby:IsA("Model") then
        local cf = try(function() return lobby:GetBoundingBox() end)
        if cf then return cf.Position end
    end
    local pad = lobby:FindFirstChild("VotePad1", true)
    local part = pad and (pad:IsA("BasePart") and pad or pad:FindFirstChild("Pad", true))
    return part and part:IsA("BasePart") and part.Position or nil
end
function Game.bounds(model)
    if not model or not model:IsDescendantOf(workspace) then return nil end
    if model:IsA("Model") then
        local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
        if ok and size.Magnitude > 0 then return cf, size end
    end
    local lo, hi
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local half = part.Size / 2
            local a, b = part.Position - half, part.Position + half
            lo = lo and Vector3.new(math.min(lo.X,a.X), math.min(lo.Y,a.Y), math.min(lo.Z,a.Z)) or a
            hi = hi and Vector3.new(math.max(hi.X,b.X), math.max(hi.Y,b.Y), math.max(hi.Z,b.Z)) or b
        end
    end
    if lo then return CFrame.new((lo + hi) / 2), hi - lo end
end
function Game.isLobbyPosition(position)
    local lobby = Game.lobbyModel()
    local cf, size = Game.bounds(lobby)
    if not cf then return nil end
    local p, half = cf:PointToObjectSpace(position), size / 2
    return math.abs(p.X) <= half.X + 12 and math.abs(p.Y) <= half.Y + 20
        and math.abs(p.Z) <= half.Z + 12
end
function Game.isMapPosition(position, map)
    local cf, size = Game.bounds(map)
    if not cf then return false end
    local p, half = cf:PointToObjectSpace(position), size / 2
    return math.abs(p.X) <= half.X + 20 and math.abs(p.Z) <= half.Z + 20
        and p.Y <= half.Y + 40 and p.Y >= -half.Y - 20
end
-- A unique map containing the player can be recognized before its coin container loads.
function Game.earlyMap(position)
    if Game.isLobbyPosition(position) ~= false then return nil end
    if now() - (Game.earlyScanAt or -100) < 0.2 then
        local cached = Game.earlyMapCache
        return cached and Game.isMapPosition(position, cached) and cached or nil
    end
    Game.earlyScanAt, Game.earlyMapCache = now(), nil
    local lobby, candidate = Game.lobbyModel(), nil
    local function offer(model)
        if model == lobby or not model:IsA("Model") then return true end
        if not (model:FindFirstChild("Spawns", true) or model:FindFirstChild("SpawnPoints", true)
            or model:FindFirstChild("CoinContainer", true)) then return true end
        if not Game.isMapPosition(position, model) then return true end
        if candidate then
            if model:IsDescendantOf(candidate) then candidate = model return true end
            if candidate:IsDescendantOf(model) then return true end
            return false
        end
        candidate = model
        return true
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj ~= lobby and (obj:IsA("Model") or obj:IsA("Folder")) then
            if not offer(obj) then return nil end
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Model") and not offer(child) then return nil end
            end
        end
    end
    Game.earlyMapCache = candidate
    return candidate
end
function Game.spawnParts()
    local sp = Game.map and Game.map:FindFirstChild("Spawns", true)
