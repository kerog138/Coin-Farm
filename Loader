    for _, node in ipairs(confirmButtons()) do existing[node] = true end
    local state = Shop.selectionState(entry)
    if state == "owned" then return false, "Selected item is already owned." end
    if state == "waiting" then return false, "Waiting for inventory data." end
    if not shopStillSelected(entry) then return false, "Auto shop stopped." end
    -- Once dispatched, never fire a second purchase blindly on a timeout.
    Shop.purchasePending = true
    if not shopClickBy(buy, method) then return false, "Purchase result uncertain; verify the inventory." end
    local deadline = now() + 8
    local confirmSent = false
    repeat
        task.wait(0.15)
        local after = readBalanceNow()
        if (after and after <= balance - entry.price) or Shop.isOwned(entry) == true then
            Shop.purchasePending = false
            balCache.at = -math.huge
            return true
        end
        if not shopStillSelected(entry) then break end
        if not confirmSent then
            local buttons = confirmButtons()
            if #buttons == 1 and not existing[buttons[1]] then
                local confirmMethod = shopMethod(buttons[1], method)
                if confirmMethod then
                    confirmSent = true
                    shopClickBy(buttons[1], confirmMethod)
                end
            end
        end
    until now() >= deadline
    return false, "Purchase result uncertain; verify the inventory before enabling auto buy again."
end
-- Dismiss only the native shop, after a confirmed purchase.
function Shop.closeAfterPurchase()
    local root = try(function() return LocalPlayer.PlayerGui.CrossPlatform.Shop end)
    if not root then return end
    local visible = {}
    for _, variant in ipairs(shopVariants()) do
        if guiVisible(variant) then visible[#visible + 1] = variant end
    end
    if #visible == 0 then return end
    for _, variant in ipairs(visible) do
        local popup = variant:FindFirstChild("BuyPopup", true)
        if popup and guiVisible(popup) then
            local close = popup:FindFirstChild("Close", true)
            local button = close and (close:IsA("GuiButton") and close or close:FindFirstChildWhichIsA("GuiButton", true))
            if button and guiVisible(button) then
                local method = shopMethod(button, Shop.workingClickMethod)
                if method then shopClickBy(button, method) task.wait(0.15) end
            end
        end
    end
    -- Preserve the active layout and its page state when the shop has its own visibility switch.
    if root:IsA("GuiObject") then
        root.Visible = false
    elseif root:IsA("ScreenGui") then
        root.Enabled = false
    else
        -- Some layouts use a Folder rather than a GUI as the shop root.
        for _, variant in ipairs(visible) do
            if variant:IsA("GuiObject") then variant.Visible = false
            elseif variant:IsA("ScreenGui") then variant.Enabled = false end
        end
    end
end
function Shop.step()
    if not Settings.autoShop or Shop.busy then return 0.8 end
    if now() < Shop.nextAt then return 0.5 end
    local catalog, balance = Shop.catalog(), readBalanceNow()
    if not balance then Shop.status = "Waiting for the coin balance..." return 2 end
    local eligible, selected, waiting, removed = {}, 0, 0, 0
    for _, entry in ipairs(catalog) do
        if Settings.shopSelected[entry.id] then
            local state = Shop.selectionState(entry)
            if state == "owned" then
                removed = removed + 1
            else
                selected = selected + 1
                if state == "waiting" then
                    waiting = waiting + 1
                elseif entry.price <= balance then
                    eligible[#eligible + 1] = entry
                end
            end
        end
    end
    if selected == 0 then
        Shop.status = removed > 0 and "Owned items deselected." or "Select a coin item below."
        return 2
    end
    if #eligible == 0 then
        Shop.status = waiting > 0 and "Waiting for inventory data."
            or "Waiting for enough coins for a selected item."
        return 2
    end
    Shop.cursor = Shop.cursor % #eligible + 1
    local entry = eligible[Shop.cursor]
    Shop.busy = true
    Shop.status = "Buying " .. entry.name .. " for " .. entry.price .. " coins..."
    Shop.purchasePending = false
    local ok, purchased, why = pcall(Shop.purchase, entry)
    Shop.busy = false
    Shop.nextAt = now() + 4
    if Shop.purchasePending then
        Shop.purchasePending = false
        set("autoShop", false)
        refresh("autoShop")
        Shop.status = "Purchase result uncertain; verify inventory, then re-enable auto buy."
        Log.warn(Shop.status)
        return 4
    end
    if ok and purchased then
        if not entry.repeatable then Shop.rememberOwned(entry.id) end
        Shop.selectionState(entry)
        Shop.status = "Bought " .. entry.name .. "."
        Log.add(Shop.status)
        local closed, closeError = pcall(Shop.closeAfterPurchase)
        if not closed then Log.warn("Could not close shop: " .. tostring(closeError)) end
        return 1
    end
    if ok and why == "Auto shop stopped." then return 1 end
    if ok and why == "Open the game's Shop once so its purchase controls load." then
        Shop.status = why
        return 2
    end
    -- Keep automatic buying enabled through a transient Shop UI failure.
    -- A longer retry interval prevents repeated window flashes and log spam.
    Shop.nextAt = now() + 10
    Shop.status = ok and tostring(why) or "Purchase error: " .. tostring(purchased)
    if Shop.lastError ~= Shop.status then
        Shop.lastError = Shop.status
        Log.warn(Shop.status)
    end
    return 4
end

