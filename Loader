    local registry = setmetatable({}, {__mode = "k"})
    local hovered, enteredAt = nil, 0
    local shownTitle, shownBody, shownWidth, shownHeight, shownViewportHeight
    local guiService = game:GetService("GuiService")
    -- AbsolutePosition and BasePlayerGui hit testing use CoreUISafeInsets
    -- coordinates even when the ScreenGui ignores insets. Normalize once.
    local function inside(node, point)
        local p, size = node.AbsolutePosition, node.AbsoluteSize
        if node:IsA("ScrollingFrame") then
            local window = node.AbsoluteWindowSize
            size = Vector2.new(math.min(size.X, window.X), math.min(size.Y, window.Y))
        end
        return size.X > 0 and size.Y > 0 and point.X >= p.X and point.X < p.X + size.X
            and point.Y >= p.Y and point.Y < p.Y + size.Y
    end
    local function ignored(node)
        return node == panel or node == UI.cursor
    end
    local function validHit(node, point)
        local cur = node
        while cur and cur ~= gui do
            if ignored(cur) then return false end
            if cur:IsA("GuiObject") then
                -- Reject off-screen children, including collapsed dropdowns,
                -- clipped scrolling rows and hidden category/page ancestors.
                if not cur.Visible or not inside(cur, point) then return false end
            end
            cur = cur.Parent
        end
        return cur == gui
    end
    local function owningTarget(node, point)
        if not validHit(node, point) then return nil end
        local cur = node
        while cur and cur ~= gui do
            local data = registry[cur]
            if data and (not data.enabled or data.enabled()) then return cur end
            cur = cur.Parent
        end
        return nil
    end
    local function blocks(node)
        return node:IsA("GuiButton") or node:IsA("TextBox") or node.Active
            or node.BackgroundTransparency < 1
    end
    local function nativeTarget(point)
        local root = gui.Parent
        while root and not root:IsA("BasePlayerGui") do root = root.Parent end
        if not root then return nil, false end
        local ok, hits = pcall(function()
            return root:GetGuiObjectsAtPosition(math.floor(point.X), math.floor(point.Y))
        end)
        if not ok or type(hits) ~= "table" then return nil, false end
        for _, node in ipairs(hits) do
            if node:IsDescendantOf(gui) and validHit(node, point) then
                local target = owningTarget(node, point)
                if target then return target, true end
                if blocks(node) then return nil, true end
            end
        end
        return nil, false
    end
    -- Fallback for hosts without a readable native hit-test root. Walk only
    -- inside actual visible ancestor rectangles, front to back. Never search
    -- the rest of a scroll list or let a child extend its parent's hitbox.
    local function fallbackTarget(point)
        local function visit(parent)
            local ordered = {}
            for i, child in ipairs(parent:GetChildren()) do
                if child:IsA("GuiObject") and child.Visible and not ignored(child) and inside(child, point) then
                    ordered[#ordered + 1] = {node = child, index = i}
                end
            end
            table.sort(ordered, function(a, b)
                if a.node.ZIndex ~= b.node.ZIndex then return a.node.ZIndex > b.node.ZIndex end
                return a.index > b.index
            end)
            for _, entry in ipairs(ordered) do
                local node = entry.node
                local target, blocked = visit(node)
                if blocked then return target, true end
                target = owningTarget(node, point)
                if target then return target, true end
                if blocks(node) then return nil, true end
            end
            return nil, false
        end
        return visit(gui)
    end
    local function targetAt(point)
        local target, resolved = nativeTarget(point)
        if resolved then return target end
        return fallbackTarget(point)
    end
    local function hide()
        panel.Visible = false
        hovered = nil
    end
    UI.dismissTooltip = hide
    bind(RunService.RenderStepped, function()
        if not Session.alive or not gui.Parent or not gui.Enabled or not UserInputService.MouseEnabled
            or UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default
            or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            or UserInputService:GetFocusedTextBox() then hide() return end
        local t = now()
        local mouse = UserInputService:GetMouseLocation()
        local point = mouse - guiService:GetGuiInset()
        local best = targetAt(point)
        if not best then hide() return end
        if hovered ~= best then
            hovered, enteredAt = best, t
            panel.Visible = false
            return
        end
        if t - enteredAt < 0.38 then return end
        local data = registry[best]
        local message = type(data.description) == "function" and data.description() or data.description
        local camera = workspace.CurrentCamera
        local vp = gui.AbsoluteSize
        if vp.X <= 0 or vp.Y <= 0 then vp = camera and camera.ViewportSize or Vector2.new(1280, 720) end
        if vp.X < 80 or vp.Y < 80 then hide() return end
        local width = math.min(270, vp.X - 16)
        if shownTitle ~= data.title or shownBody ~= message or shownWidth ~= width or shownViewportHeight ~= vp.Y then
            shownTitle, shownBody, shownWidth, shownViewportHeight = data.title, message, width, vp.Y
            title.Text, body.Text = data.title, message
            local measured = textService:GetTextSize(message, 12, Theme.Font, Vector2.new(width - 26, 1000))
            shownHeight = math.min(vp.Y - 16, 44 + math.max(17, measured.Y + 4))
            panel.Size = UDim2.fromOffset(width, shownHeight)
            body.Size = UDim2.new(1, -26, 0, shownHeight - 40)
        end
        local localMouse = point - gui.AbsolutePosition
        local x, y = localMouse.X + 21, localMouse.Y + 23
        if x + width > vp.X - 8 then x = localMouse.X - width - 21 end
        if y + shownHeight > vp.Y - 8 then y = localMouse.Y - shownHeight - 18 end
        panel.Position = UDim2.fromOffset(clamp(x, 8, vp.X - width - 8), clamp(y, 8, vp.Y - shownHeight - 8))
        panel.Visible = true
    end)
    return function(node, heading, key, custom, enabled)
        registry[node] = {title = heading, description = custom or descriptions[key or heading] or "Select this option to change " .. heading .. ".", enabled = enabled}
    end
end

function UI.build()
