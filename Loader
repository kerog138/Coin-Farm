function Farm.underY(here)
    local y = here.Y - VOID_GAP
    local bottom = Game.mapBottom()
    if bottom then y = math.min(y, bottom - VOID_GAP) end
    for _, s in ipairs(Game.spawnParts()) do y = math.min(y, s.Position.Y - VOID_GAP) end
    local killY = try(function() return workspace.FallenPartsDestroyHeight end) or -500
