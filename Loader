local AFTER_FULL = {"reset", "spawn", "xp"}
local HOOK_TIMES = {10, 20, 30, 60, 120, 180}
local HOOK_LABELS = {"10m", "20m", "30m", "1h", "2h", "3h"}
local Defaults = {
    farm = false, speed = 17, prone = true, underRoute = false, avoid = 20,
    farFromPlayers = false, bagSize = 40, noclip = true, afterFull = "reset",
    autoVote = false, antiAfk = false, overlay = true, squareSize = 72, overlayScale = 100, squareScale = 100, antiFling = false,
    keyFarm = "F2", keyMenu = "RightControl", hookOn = false, hookUrl = "", hookName = "", hookEvery = 10,
}
local Settings = {}
for k, v in pairs(Defaults) do Settings[k] = v end
local dirty = false

local function isWebhook(url)
    return type(url) == "string" and (url:match("^https://discord%.com/api/webhooks/%d+/[%w%-_]+$")
        or url:match("^https://discordapp%.com/api/webhooks/%d+/[%w%-_]+$")
        or url:match("^https://ptb%.discord%.com/api/webhooks/%d+/[%w%-_]+$")
        or url:match("^https://canary%.discord%.com/api/webhooks/%d+/[%w%-_]+$")) ~= nil
end
local function validate(k, v)
    local d = Defaults[k]
    if d == nil or type(v) ~= type(d) then return nil end
    if type(v) == "number" and (v ~= v or v == math.huge or v == -math.huge) then return nil end
    if k == "speed" then return math.floor(clamp(v, 1, 25)) end
    if k == "avoid" then return math.floor(clamp(v, 0, 100)) end
    if k == "squareSize" then return math.floor(clamp(v, 40, 160)) end
    if k == "squareScale" then return math.floor(clamp(v, 25, 100)) end
    if k == "overlayScale" then return math.floor(clamp(v, 75, 175)) end
    if k == "bagSize" then return v >= 45 and 50 or 40 end
    if k == "afterFull" then return table.find(AFTER_FULL, v) and v or nil end
    if k == "keyFarm" or k == "keyMenu" then return pcall(function() return Enum.KeyCode[v] end) and v or nil end
    if k == "hookUrl" then v = trim(v) if v ~= "" and not isWebhook(v) then return nil end end
    if k == "hookName" then
        v = trim(v):sub(1, 80)
        if v:lower():find("discord", 1, true) or v:lower():find("clyde", 1, true) then return nil end
    end
    if k == "hookEvery" then
        local best = HOOK_TIMES[1]
        for _, m in ipairs(HOOK_TIMES) do if math.abs(m - v) < math.abs(best - v) then best = m end end
        return best
    end
    return v
end
local function set(k, v)
    local value = validate(k, v)
    if value == nil then return false end
    if Settings[k] ~= value then Settings[k], dirty = value, true end
    return true
end
local function loadSettings()
    local data = try(function() return HttpService:JSONDecode(readFile(FILES.settings) or "{}") end)
    if type(data) == "table" then
        for k, v in pairs(data) do local value = validate(k, v) if value ~= nil then Settings[k] = value end end
    end
    Settings.farm = false
end
local function saveSettings()
    local ok, text = pcall(function() return HttpService:JSONEncode(Settings) end)
    if ok and writeFile(FILES.settings, text) then dirty = false end
end

