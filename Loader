    if owned == true then
        Shop.rememberOwned(entry.id)
        if Settings.shopSelected[entry.id] then
            Settings.shopSelected[entry.id] = nil
            dirty = true
        end
        return "owned"
    end
    if owned == nil then return "waiting" end
    return nil
end
end
local function guiVisible(node)
    while node and node ~= LocalPlayer.PlayerGui do
        if node:IsA("GuiObject") and not node.Visible then return false end
        if node:IsA("ScreenGui") and not node.Enabled then return false end
        node = node.Parent
    end
