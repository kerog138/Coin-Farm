            Size = UDim2.fromScale(1, 1), TextTransparency = 0, ZIndex = 5002, Parent = planeHolder})
    end

    local elapsedStart = now()
    local finishAt = elapsedStart + LOADING_CONFIG.LoadingSeconds
    local function smooth(node, seconds, properties)
        tween(node, seconds, properties, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    end
    smooth(overlay, LOADING_CONFIG.IntroFadeSeconds, {BackgroundTransparency = 0})

    -- Audio is optional and must never delay or interrupt the loading screen.
    task.spawn(function()
        local sound
        local ok, err = pcall(function()
            local audioId = LOADING_CONFIG.AudioId
            if type(audioId) ~= "string" or not audioId:match("^rbxassetid://%d+$") then
                audioId = nil
                local file = LOADING_CONFIG.LocalAudioFile
                local assetLoader = type(getcustomasset) == "function" and getcustomasset
                    or type(getsynasset) == "function" and getsynasset or nil
                if assetLoader and type(writefile) == "function" and type(file) == "string" and file ~= "" then
                    pcall(function()
                        ensureFolder()
                        writefile(file, decodeEmbeddedPng(LOADING_AUDIO_MP3_B64))
                    end)
                    if type(isfile) == "function" and isfile(file) then
                        audioId = assetLoader(file)
                    end
                end
            end
            if type(audioId) ~= "string" or audioId == "" or not overlay.Parent then return end
            sound = create("Sound", {Name = "LoadingMusic", SoundId = audioId,
                Volume = 0, Looped = false, Parent = overlay})
            local deadline = math.min(now() + 2.0, finishAt - 1.2)
            while overlay.Parent and not sound.IsLoaded and now() < deadline do task.wait(0.05) end
            if not overlay.Parent or not sound.IsLoaded then return end
            local duration = math.min(LOADING_CONFIG.AudioSeconds, finishAt - now() - 0.05)
            if sound.TimeLength > 0 then
                duration = math.min(duration, sound.TimeLength - LOADING_CONFIG.AudioStart)
            end
            if duration <= 0.1 then return end
            local fadeIn = math.min(LOADING_CONFIG.AudioFadeIn, duration * 0.40)
            local fadeOut = math.min(LOADING_CONFIG.AudioFadeOut, duration * 0.45)
            sound.TimePosition = math.max(0, LOADING_CONFIG.AudioStart)
            sound:Play()
            local audioStart = now()
            smooth(sound, fadeIn, {Volume = clamp(LOADING_CONFIG.AudioVolume, 0, 1)})
            local untilFade = audioStart + duration - fadeOut - now()
            if untilFade > 0 then task.wait(untilFade) end
            if not overlay.Parent or not sound.Parent then return end
            smooth(sound, fadeOut, {Volume = 0})
            local untilStop = audioStart + duration - now()
            if untilStop > 0 then task.wait(untilStop) end
        end)
        if sound then pcall(function() sound:Stop() sound:Destroy() end) end
        if not ok then Log.warn("loading audio: " .. tostring(err)) end
    end)

    smooth(logo, 0.95, logo:IsA("ImageLabel") and {ImageTransparency = 0} or {TextTransparency = 0})
    smooth(title, 0.65, {TextTransparency = 0})
    smooth(sub, 0.65, {TextTransparency = 0.08})
    smooth(percent, 0.40, {TextTransparency = 0})
    smooth(barBack, 0.45, {BackgroundTransparency = 0.12})
    smooth(barFill, 0.45, {BackgroundTransparency = 0})

    -- Random-looking display progress, not a measurement of actual download progress.
    local marks = {math.random(10, 22), math.random(28, 39), math.random(45, 57),
        math.random(66, 78), math.random(87, 95), 98, 99, 100}
    local times = {0.15, 0.27, 0.39, 0.51, 0.63, 0.74, 0.81, 0.87}
    local fade = math.max(0.1, LOADING_CONFIG.FadeSeconds)
    local loadingSeconds = math.max(0.8, LOADING_CONFIG.LoadingSeconds - fade)
    for i, value in ipairs(marks) do
        local waitFor = elapsedStart + loadingSeconds * times[i] - now()
        if waitFor > 0 then task.wait(waitFor) end
        percent.Text = tostring(value) .. "%"
        smooth(barFill, 0.14, {Size = UDim2.fromScale(value / 100, 1)})
    end
    local remaining = elapsedStart + loadingSeconds - now()
    if remaining > 0 then task.wait(remaining) end

    sub.Text = "Ready."
    -- Both credits have been visible throughout the animation.
    if main then main.Visible = true end
    for _, node in ipairs({logo, title, sub, percent, credit, plane, barBack, barFill}) do
        pcall(function()
            if node:IsA("ImageLabel") then smooth(node, fade, {ImageTransparency = 1})
            elseif node:IsA("TextLabel") then smooth(node, fade, {TextTransparency = 1})
            elseif node:IsA("Frame") then smooth(node, fade, {BackgroundTransparency = 1}) end
        end)
    end
    smooth(overlay, fade, {BackgroundTransparency = 1})
    task.wait(fade)
    if overlay.Parent then overlay:Destroy() end
end

