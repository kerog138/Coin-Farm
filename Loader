function UI.build()
    local gui = create("ScreenGui", {Name = "MM2Hub", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999})
    if type(syn) == "table" and type(syn.protect_gui) == "function" then pcall(syn.protect_gui, gui) end
    for _, getParent in ipairs({
        function() return type(gethui) == "function" and gethui() or nil end,
        function() return game:GetService("CoreGui") end,
        function() return LocalPlayer:WaitForChild("PlayerGui", 10) end,
    }) do
        if pcall(function() local p = getParent() if p then gui.Parent = p end end) and gui.Parent then break end
    end
    UI.gui = gui

    local W, H, SIDE, TOP = 560, 380, 136, 44
    local main = create("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H),
        BackgroundColor3 = Theme.Bg, ClipsDescendants = true, Active = true, Parent = gui}, {corner(10), stroke()})
    local scale = create("UIScale", {Parent = main})
