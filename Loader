        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
        return clamp(math.min((vp.X - 32) / W, (vp.Y - 32) / H), 0.55, 1)
    end
    UI.baseScale = fitScale()
    if workspace.CurrentCamera then
        bind(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
            UI.baseScale = fitScale()
            scale.Scale = UI.baseScale
        end)
    end

    local top = create("Frame", {Size = UDim2.new(1, 0, 0, TOP), BackgroundTransparency = 1, Parent = main})
    create("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.Stroke, Parent = top})
    create("TextLabel", {Text = "MM2-HUB", Font = Theme.Bold, TextSize = 15, TextColor3 = Theme.Text, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 0), Size = UDim2.new(0, 80, 1, 0), TextXAlignment = LEFT, Parent = top})
