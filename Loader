local function ownedRecord(value, inOwnedList)
    if value == true then return true end
    if type(value) == "number" or type(value) == "string" then
        local amount = tonumber(value)
        return amount ~= nil and amount > 0
    end
    if type(value) ~= "table" then return false end
    for _, field in ipairs({"Owned", "owned", "Unlocked", "unlocked", "Amount", "amount", "Count", "count", "Quantity", "quantity"}) do
        local flag = rawget(value, field)
        if type(flag) == "boolean" then return flag end
        if type(flag) == "number" or type(flag) == "string" then
            local amount = tonumber(flag)
            if amount ~= nil then return amount > 0 end
        end
    end
    return inOwnedList and next(value) ~= nil
end
local function matchOwnedList(list, keys, inOwnedList)
    if type(list) ~= "table" then return false end
    for k, v in pairs(list) do
        if type(k) == "string" and keys[shopKey(k)] and ownedRecord(v, inOwnedList) then return true end
        if type(k) == "number" then
            if type(v) == "string" and keys[shopKey(v)] then return true end
            if type(v) == "table" then
                local id = v.ItemID or v.ItemId or v.ID or v.Id or v.id or v.Name or v.name
                if type(id) == "string" and keys[shopKey(id)] and ownedRecord(v, inOwnedList) then return true end
            end
        end
    end
    return false
end
function Shop.isOwned(entry)
